# mp3 static assets for honeycomb
/apps/www/public/sfx

# ...except the small, curated leetype demo samples used by the static
# GitHub Pages build (see packages/some-content-registry) - everything
# else under packages/**/public (honeycomb sfx, the full leetype code
# corpus) stays locally-populated/volume-mounted, never committed.
# !packages/some-content/public/
# !packages/some-content/public/code-samples/
# !packages/some-content/public/code-samples/**

# Generated UI build outputs
packages/ui/**/public/

# Test artifacts
extensions/**/test-results/

# Signed extension artifacts (web-ext sign) — never commit credentials or .xpi
extensions/**/artifacts/
*.xpi


