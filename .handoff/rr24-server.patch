+/// (RR24). [`Final::answers`] borrows them.
+#[must_use]
+pub fn rust_answers(sent: Option<&crate::sent::Sent>) -> Vec<(String, String)> {
+	sent.map_or_else(Vec::new, |sent| {
+		sent
+			.answers
