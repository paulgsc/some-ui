+		assert_eq!(pass(&pool, &fake).await.unwrap().kept, 1);
+		let rows = || async {
+			sqlx::query_as::<_, (i64, String)>("SELECT seq, queued_at FROM rust_round_source ORDER BY seq")
+				.fetch_all(&pool)
