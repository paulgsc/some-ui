
export NODE_OPTIONS=--max-old-space-size=4096

# lint-staged runs eslint/tsc/prettier per touched package - for a commit
# spanning many workspaces that's routinely slower than this sandbox's
# command timeout, and it hangs the commit rather than failing it. Claude
# Code Remote sessions must instead verify the same checks manually before
# committing (see CLAUDE.md) - commit-msg (commitlint) still runs either way.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
  echo "pre-commit: skipping lint-staged in Claude Code Remote - CLAUDE.md requires the agent to have verified lint/typecheck/prettier manually already."
  exit 0
fi

pnpm dlx lint-staged --concurrent false
