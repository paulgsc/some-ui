{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "some-ui-mailbox",
  "main": "src/index.ts",
  // Pinned, not "today": a Worker's behaviour follows this date. Raise it on purpose.
  "compatibility_date": "2026-10-01",
  // No tokens here, ever (MB3): they are Worker secrets (`wrangler secret put`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "some-ui-mailbox",
      // Not a secret.
      "database_id": "2e57f2ee-cb4e-4827-8135-e91183bbe762",
      "migrations_dir": "migrations",
    },
  ],
  // The bell home listens on (MBP1, paulgsc/some-ui#2142). Workers Free takes
  // only SQLite-backed Durable Objects, so it is a `new_sqlite_classes` class.
  "durable_objects": {
    "bindings": [{ "name": "BELL", "class_name": "Bell" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bell"] }],
}
