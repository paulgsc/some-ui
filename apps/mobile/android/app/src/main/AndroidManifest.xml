<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The soundbites page (www routes/_dashboard/_apk/soundbites.tsx,
         @some-ui/soundbites): saying out loud why a session did not happen.
         The page asks the WebView for the microphone (getUserMedia), and
         Capacitor's BridgeWebChromeClient turns that into a request for both
         of these, which Android grants only if the manifest declares them.
         RECORD_AUDIO is the runtime prompt the person sees, the first time
         they tap to talk; MODIFY_AUDIO_SETTINGS (install-time, no prompt) is
         what the WebView's audio capture needs to route the microphone.
         The Build Journal's voice takes (www routes/_dashboard/_apk/journal.tsx)
         and voice reflections (www src/lib/reflection-voice) record through
         the same path. Studio's idea capture (ListenPlugin) asks for
         RECORD_AUDIO itself. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Studio's idea capture (www src/lib/device-listen, ListenPlugin):
         from Android 11, an app sees the phone's speech recognizer only if
         it says it looks for one. Without this, SpeechRecognizer
         .isRecognitionAvailable answers false and every question takes
         typed words. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- androidx.biometric (a dependency of @capacitor-community/sqlite)
         declares these two, but the plugin reaches its biometric code only
         when capacitor.config sets both plugins.CapacitorSQLite
         androidIsEncryption and androidBiometric.biometricAuth to true. This
         app sets androidIsEncryption to false (the plugin's default is true;
         capacitor.config.ts says why), so the database is not encrypted and
         nothing prompts for a fingerprint. So the app asks for neither.
         Setting biometricAuth later means deleting these two lines and
         listing both in review/policy.json. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- @capacitor/local-notifications (8.x) declares this, but study nudges
         are inexact alarms: www's lib/study-nudge/native.ts schedules them
         with isExactNotification: false, so the plugin never asks for exact
         ones. Play restricts it to alarm-clock and calendar apps, and Android
         14 denies it by default to everything else. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- Backup: README "Play readiness", PD3. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- Cleartext is for the unpaired sync from home only: published
             lessons and rounds, read with no credential from a plain-http LAN
             address (http://<lan-ip>:3000), which Android refuses to reach from
             targetSdk 28 on unless allowed here. A network security config
             cannot scope this to "private addresses"; it takes named hosts, and
             the LAN address is whatever the person types. Everything else the
             app loads is its own bundle, over https. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Wings: one launcher icon per wing, each opening the app straight
             into that wing (README "What the app carries"). Aliases of
             .MainActivity, not activities of their own, so every icon shares
             one task, one WebView and one database connection. MainActivity
             maps the alias's name to the wing's root path through a fixed
             table (wingRoot), never through anything the intent carries, so
             being exported lets another app do no more than a tap on the
             icon does. The names are frozen once shipped, as applicationId
             is: the launcher keys home-screen icons and folders by component,
             so a renamed or deleted alias silently drops off every home
             screen. The plain icon stays .MainActivity for the same reason. -->
        <activity-alias
            android:name=".WingPractice"
            android:targetActivity=".MainActivity"
            android:label="@string/wing_practice"
            android:icon="@mipmap/ic_wing_practice"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".WingSelf"
            android:targetActivity=".MainActivity"
            android:label="@string/wing_self"
            android:icon="@mipmap/ic_wing_self"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".WingStudio"
            android:targetActivity=".MainActivity"
            android:label="@string/wing_studio"
            android:icon="@mipmap/ic_wing_studio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".WingJobs"
            android:targetActivity=".MainActivity"
            android:label="@string/wing_jobs"
            android:icon="@mipmap/ic_wing_jobs"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- No FCM token until the Jobs notice is turned on (README "The
             Jobs arrival notice"); the push plugin's register() turns this
             back on. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

</manifest>
