<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- androidx.biometric (a dependency of @capacitor-community/sqlite)
         declares these two, but the plugin reaches its biometric code only
         when capacitor.config sets both plugins.CapacitorSQLite
         androidIsEncryption and androidBiometric.biometricAuth, and this app
         sets neither: the database is not encrypted and nothing prompts for a
         fingerprint. So the app asks for neither. Setting biometricAuth later
         means deleting these two lines and listing both in
         review/policy.json. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- Cleartext is for the sync from home only: the home file_host is a
             plain-http LAN address (http://<lan-ip>:3000), which Android refuses
             to reach from targetSdk 28 on unless allowed here. A network
             security config cannot scope this to "private addresses"; it takes
             named hosts, and the LAN address is whatever the person types.
             Everything else the app loads is its own bundle, over https. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
