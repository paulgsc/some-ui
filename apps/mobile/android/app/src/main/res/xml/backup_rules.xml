<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 (API 30) and earlier: everything the app keeps
     is backed up (README "Play readiness", PD3) except the home-server
     pairing (HomeCredentialPlugin.PREFS), a credential that must not reach a
     backup or a new phone. Android 12+ reads data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="home_credential.xml" />
</full-backup-content>
