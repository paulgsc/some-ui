{
  "name": "www",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --port 5173",
    "build": "vite build && tsc",
    "build:analyze": "node scripts/analyze-bundle.js",
    "analyze": "pnpm run build:analyze && open dist/bundle-analysis.html",
    "analyze:ci": "pnpm run build:analyze",
    "serve": "vite preview",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.7",
    "@some-ui/content": "workspace:*",
    "@some-ui/honeycomb": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.2.2",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.130.2",
    "@tanstack/react-router-devtools": "^1.131.5",
    "@tanstack/router-plugin": "^1.121.2",
    "lucide-react": "^0.378.0",
    "@some-ui/fetch-kit": "workspace:*",
    "@some-ui/makjang": "workspace:*",
    "@some-ui/overlays": "workspace:*",
    "@some-ui/portfolio": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@some-ui/chat": "workspace:*",
    "some-types-utils": "workspace:*",
    "some-ui-input": "workspace:*",
    "some-ui-neon-sign": "workspace:*",
    "some-ui-nfl": "workspace:*",
    "some-ui-shared": "workspace:*",
    "@some-ui/slideshow": "workspace:*",
    "@some-ui/stepper": "workspace:*",
    "some-ui-utils": "workspace:*",
    "@some-ui/umag": "workspace:*",
    "wireframes": "workspace:*",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "rollup-plugin-visualizer": "^5.12.0",
    "vite": "^8.1.4",
    "web-vitals": "^4.2.4"
  }
}
