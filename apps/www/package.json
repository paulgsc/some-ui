{
  "name": "www",
  "private": true,
  "version": "0.1.45",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-resume.mjs && vite",
    "start": "node scripts/sync-resume.mjs && vite --port 5173",
    "content:link": "node scripts/link-content-assets.js",
    "build": "node scripts/sync-resume.mjs && vite build && tsc",
    "build:fit": "WWW_FIT_HARNESS=1 vite build --outDir out/ui-fit --emptyOutDir",
    "check:bundle-paths": "node check-bundle-paths.ts",
    "serve": "vite preview",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:intent": "vitest run intent.test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:ui-fit": "playwright test --config playwright.config.ts tests/ui-fit",
    "test:sw": "playwright test --config playwright.config.ts tests/study-nudge",
    "record:playoff-delta": "tsx tests/record/playoff-delta.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "catalog:",
    "@some-ui/activity-catalog": "workspace:*",
    "@some-ui/aph": "workspace:*",
    "@some-ui/auth": "workspace:*",
    "@some-ui/content-registry": "workspace:*",
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/fetch-kit": "workspace:*",
    "@some-ui/honeycomb": "workspace:*",
    "@some-ui/intent-kit": "workspace:*",
    "@some-ui/lesson-crm": "workspace:*",
    "@some-ui/playoff-delta": "workspace:*",
    "@some-ui/react-hooks": "workspace:*",
    "@some-ui/resume": "workspace:*",
    "@some-ui/shared": "workspace:*",
    "@some-ui/soundbites": "workspace:*",
    "@some-ui/speech": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "@some-ui/topik": "workspace:*",
    "@some-ui/types": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@some-ui/voice-capture": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "^0.2.2",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.130.2",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.42",
    "lucide-react": "catalog:",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "usehooks-ts": "3.1.1",
    "web-vitals": "^6.2.2",
    "wireframes": "workspace:*",
    "zod": "catalog:",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@some-ui/contract-harness": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
