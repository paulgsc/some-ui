{
  "$comment": [
    "Shared decision table for the study nudge, run by two test suites in two repositories:",
    "  - Rust:       apps/servers/file_host/src/nudge/policy_fixtures.rs (paulgsc/server, canonical copy)",
    "  - TypeScript: apps/www/src/lib/study-nudge/index.test.ts          (paulgsc/some-ui)",
    "",
    "The client policy does not go away — the GitHub Pages build has no backend, so",
    "`decideNudge` stays its decision. Two implementations of one rule set drift, and this",
    "file is the cheapest defence: a change made on one side and not the other fails a test",
    "rather than quietly changing behaviour.",
    "",
    "The duplication is real and is not solved here: this repository cannot publish to",
    "paulgsc/some-ui, so the TypeScript side has to vendor or fetch this file. That is",
    "written down in docs/study-nudge.md under 'Known unknowns' rather than left implicit.",
    "",
    "`now` and every session timestamp are UTC instants. `timezone` names the zone the",
    "decision is evaluated in; the TypeScript suite runs in the viewer's zone, so cases meant",
    "to be shared with it use UTC and hours far from any boundary.",
    "",
    "Fields omitted from a session take the values in `defaults` below."
  ],

  "defaults": {
    "session": {
      "name": "Korean review",
      "status": "scheduled",
      "activities": [],
      "scenes": [],
      "layoutMode": "basic",
      "totalDurationMs": 600000,
      "createdAt": "2026-03-14T09:00:00.000Z",
      "updatedAt": "2026-03-14T09:00:00.000Z"
    },
    "preferences": {
      "enabled": true,
      "quietHoursStart": 22,
      "quietHoursEnd": 8,
      "minHoursBetweenNudges": 4
    },
    "now": "2026-03-15T14:00:00.000Z",
    "timezone": "UTC",
    "pageVisible": false,
    "lastNudgeAt": null
  },

  "cases": [
    {
      "name": "nudges when a scheduled session is waiting and nothing blocks it",
      "sessions": [{ "id": "s1", "name": "Hangul drill" }],
      "expect": {
        "kind": "nudge",
        "sessionId": "s1",
        "title": "Today's session is ready",
        "body": "Hangul drill · 0 activities · ~10 min"
      }
    },
    {
      "name": "stays silent when reminders are off, even with everything else ready",
      "sessions": [{ "id": "s1" }],
      "preferences": { "enabled": false },
      "expect": { "kind": "silent", "reason": "disabled" }
    },
    {
      "name": "stays silent while the app is on screen",
      "sessions": [{ "id": "s1" }],
      "pageVisible": true,
      "expect": { "kind": "silent", "reason": "page-visible" }
    },
    {
      "name": "stays silent during quiet hours",
      "sessions": [{ "id": "s1" }],
      "now": "2026-03-15T23:00:00.000Z",
      "expect": { "kind": "silent", "reason": "quiet-hours" }
    },
    {
      "name": "permits the hour quiet hours end on, since the range is half-open",
      "sessions": [{ "id": "s1" }],
      "now": "2026-03-15T08:00:00.000Z",
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "stays silent in the small hours the wrapping range covers",
      "sessions": [{ "id": "s1" }],
      "now": "2026-03-15T03:00:00.000Z",
      "expect": { "kind": "silent", "reason": "quiet-hours" }
    },
    {
      "name": "equal quiet-hour bounds mean no quiet hours rather than always quiet",
      "sessions": [{ "id": "s1" }],
      "now": "2026-03-15T03:00:00.000Z",
      "preferences": { "quietHoursStart": 9, "quietHoursEnd": 9 },
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "stays silent while a session is actually running",
      "sessions": [{ "id": "s1" }, { "id": "s2", "status": "active" }],
      "expect": { "kind": "silent", "reason": "session-in-progress" }
    },
    {
      "name": "session-in-progress outranks studied-today",
      "sessions": [
        { "id": "s1" },
        { "id": "s2", "status": "active" },
        {
          "id": "s3",
          "status": "completed",
          "startedAt": "2026-03-15T09:00:00.000Z",
          "completedAt": "2026-03-15T10:00:00.000Z"
        }
      ],
      "expect": { "kind": "silent", "reason": "session-in-progress" }
    },
    {
      "name": "stays silent once something was started today",
      "sessions": [
        { "id": "s1" },
        {
          "id": "s2",
          "status": "completed",
          "startedAt": "2026-03-15T09:00:00.000Z",
          "completedAt": "2026-03-15T10:00:00.000Z"
        }
      ],
      "expect": { "kind": "silent", "reason": "studied-today" }
    },
    {
      "name": "nudges again the next day, when yesterday's session is the only history",
      "sessions": [
        { "id": "s1" },
        {
          "id": "s2",
          "status": "completed",
          "startedAt": "2026-03-14T09:00:00.000Z",
          "completedAt": "2026-03-14T10:00:00.000Z"
        }
      ],
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "editing a session today does not count as having studied",
      "sessions": [{ "id": "s1", "updatedAt": "2026-03-15T11:00:00.000Z" }],
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "a session paused today suppresses the nudge",
      "sessions": [
        {
          "id": "s1",
          "status": "paused",
          "startedAt": "2026-03-15T09:00:00.000Z"
        }
      ],
      "expect": { "kind": "silent", "reason": "studied-today" }
    },
    {
      "name": "stays silent when nothing is prepared at all",
      "sessions": [],
      "expect": { "kind": "silent", "reason": "nothing-prepared" }
    },
    {
      "name": "a completed session is not a candidate",
      "sessions": [{ "id": "s1", "status": "completed" }],
      "expect": { "kind": "silent", "reason": "nothing-prepared" }
    },
    {
      "name": "stays silent inside the cooldown",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "2026-03-15T12:00:00.000Z",
      "expect": { "kind": "silent", "reason": "cooling-down" }
    },
    {
      "name": "speaks again once the cooldown lapses",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "2026-03-15T08:00:00.000Z",
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "reports the more specific reason when nothing is prepared AND it is cooling down",
      "sessions": [],
      "lastNudgeAt": "2026-03-15T12:00:00.000Z",
      "expect": { "kind": "silent", "reason": "nothing-prepared" }
    },
    {
      "name": "treats an unparseable cooldown stamp as expired rather than muting forever",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "not-a-date",
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "name": "prefers a paused session over a scheduled one, and says what is left",
      "sessions": [
        { "id": "scheduled", "status": "scheduled" },
        {
          "id": "paused",
          "name": "TOPIK reading",
          "status": "paused",
          "totalDurationMs": 1200000,
          "finalElapsedMs": 480000
        }
      ],
      "expect": {
        "kind": "nudge",
        "sessionId": "paused",
        "title": "Pick up where you left off",
        "body": "TOPIK reading · 12 min left"
      }
    },
    {
      "name": "a session paused yesterday is the best candidate of all",
      "sessions": [
        { "id": "scheduled", "status": "scheduled" },
        {
          "id": "paused",
          "status": "paused",
          "startedAt": "2026-03-14T20:00:00.000Z"
        }
      ],
      "expect": { "kind": "nudge", "sessionId": "paused" }
    },
    {
      "name": "prefers a scheduled session over a draft",
      "sessions": [
        { "id": "draft", "status": "draft" },
        { "id": "scheduled", "status": "scheduled" }
      ],
      "expect": { "kind": "nudge", "sessionId": "scheduled" }
    },
    {
      "name": "breaks a rank tie by most recently updated",
      "sessions": [
        { "id": "older", "updatedAt": "2026-03-14T09:00:00.000Z" },
        { "id": "newer", "updatedAt": "2026-03-14T18:00:00.000Z" }
      ],
      "expect": { "kind": "nudge", "sessionId": "newer" }
    },
    {
      "name": "a rank tie keeps the first when neither is newer",
      "sessions": [
        { "id": "first", "updatedAt": "2026-03-14T09:00:00.000Z" },
        { "id": "second", "updatedAt": "2026-03-14T09:00:00.000Z" }
      ],
      "expect": { "kind": "nudge", "sessionId": "first" }
    },
    {
      "name": "pluralises a single activity",
      "sessions": [
        {
          "id": "s1",
          "activities": [{ "activityId": "honeycomb", "config": {} }]
        }
      ],
      "expect": {
        "kind": "nudge",
        "sessionId": "s1",
        "body": "Korean review · 1 activity · ~10 min"
      }
    },
    {
      "name": "pluralises two activities",
      "sessions": [
        {
          "id": "s1",
          "activities": [
            { "activityId": "honeycomb", "config": {} },
            { "activityId": "topik", "config": {} }
          ]
        }
      ],
      "expect": {
        "kind": "nudge",
        "sessionId": "s1",
        "body": "Korean review · 2 activities · ~10 min"
      }
    },
    {
      "name": "a sub-minute session reads as one minute rather than zero",
      "sessions": [{ "id": "s1", "totalDurationMs": 1000 }],
      "expect": {
        "kind": "nudge",
        "sessionId": "s1",
        "body": "Korean review · 0 activities · ~1 min"
      }
    },
    {
      "name": "a paused session with no recorded progress reports its whole duration",
      "sessions": [
        { "id": "s1", "status": "paused", "totalDurationMs": 900000 }
      ],
      "expect": {
        "kind": "nudge",
        "sessionId": "s1",
        "title": "Pick up where you left off",
        "body": "Korean review · 15 min left"
      }
    },
    {
      "$comment": [
        "Server-only from here down: these exercise the configured timezone, which the",
        "client gets from the viewer's machine and therefore cannot vary. The TypeScript",
        "suite skips any case carrying `serverOnly: true`."
      ],
      "serverOnly": true,
      "name": "an evening session counts as today even though its UTC date is tomorrow",
      "timezone": "America/Denver",
      "now": "2026-03-16T02:00:00.000Z",
      "sessions": [
        { "id": "s1" },
        {
          "id": "s2",
          "status": "completed",
          "completedAt": "2026-03-16T00:00:00.000Z"
        }
      ],
      "expect": { "kind": "silent", "reason": "studied-today" }
    },
    {
      "serverOnly": true,
      "name": "quiet hours are evaluated against the configured zone, not the container's",
      "timezone": "America/Denver",
      "now": "2026-03-16T05:00:00.000Z",
      "sessions": [{ "id": "s1" }],
      "expect": { "kind": "silent", "reason": "quiet-hours" }
    },
    {
      "serverOnly": true,
      "name": "the same instant is a permitted hour when read as UTC, which is the bug",
      "timezone": "UTC",
      "now": "2026-03-16T05:00:00.000Z",
      "sessions": [{ "id": "s1" }],
      "expect": { "kind": "silent", "reason": "quiet-hours" }
    },
    {
      "serverOnly": true,
      "name": "a day already nudged stays quiet, and says so distinctly from the cooldown",
      "sessions": [{ "id": "s1" }],
      "today": {
        "localDay": "2026-03-15",
        "sentAt": "2026-03-15T09:00:00.000Z",
        "sendCount": 1
      },
      "expect": { "kind": "silent", "reason": "already-nudged-today" }
    },
    {
      "serverOnly": true,
      "name": "a live snooze is its own reason, not folded into cooling-down",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "2026-03-15T13:30:00.000Z",
      "today": {
        "localDay": "2026-03-15",
        "sentAt": "2026-03-15T13:30:00.000Z",
        "sendCount": 1,
        "snoozeCount": 1,
        "snoozedUntil": "2026-03-15T14:30:00.000Z"
      },
      "expect": { "kind": "silent", "reason": "snoozed" }
    },
    {
      "serverOnly": true,
      "name": "a snooze that has come due reopens the day, cooldown notwithstanding",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "2026-03-15T13:00:00.000Z",
      "today": {
        "localDay": "2026-03-15",
        "sentAt": "2026-03-15T13:00:00.000Z",
        "sendCount": 1,
        "snoozeCount": 1,
        "snoozedUntil": "2026-03-15T13:45:00.000Z"
      },
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "serverOnly": true,
      "name": "a second dismissal means silence until tomorrow",
      "sessions": [{ "id": "s1" }],
      "today": {
        "localDay": "2026-03-15",
        "sentAt": "2026-03-15T13:00:00.000Z",
        "sendCount": 2,
        "snoozeCount": 2,
        "snoozedUntil": "2026-03-15T13:45:00.000Z"
      },
      "expect": { "kind": "silent", "reason": "already-nudged-today" }
    },
    {
      "serverOnly": true,
      "name": "yesterday's snooze does not suppress today",
      "sessions": [{ "id": "s1" }],
      "lastNudgeAt": "2026-03-14T20:00:00.000Z",
      "today": null,
      "expect": { "kind": "nudge", "sessionId": "s1" }
    },
    {
      "serverOnly": true,
      "name": "nothing-prepared still outranks the server-only reasons",
      "sessions": [],
      "today": {
        "localDay": "2026-03-15",
        "sentAt": "2026-03-15T09:00:00.000Z",
        "sendCount": 1
      },
      "expect": { "kind": "silent", "reason": "nothing-prepared" }
    }
  ]
}
