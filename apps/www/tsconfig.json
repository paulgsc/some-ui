{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@some-ui/content/*": ["../../packages/some-content/src/*"],
      "@some-ui/content": ["../../packages/some-content/src"],
      "@content/*": ["../../packages/some-content/src/*"]
    }
  },
  "include": [
    "eslint.config.js",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/some-content/src/**/*"
  ]
}
