// general_info_tab.slint - General Info tab content
import { LineEdit } from "std-widgets.slint";

component FormField inherits VerticalLayout {
    in property <string> label;
    
    spacing: 8px;
    
    Text {
        text: root.label;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        horizontal-alignment: left;
    }
    
    @children
}

export component GeneralInfoTab inherits Rectangle {
    in-out property <string> stream-title;
    in-out property <string> short-description;
    in-out property <string> stream-date-time;
    in-out property <string> host-name;
    in-out property <string> host-role;
    
    background: transparent;
    
    VerticalLayout {
        spacing: 24px;
        
        // Header
        Text {
            text: "General Info";
            font-size: 24px;
            font-weight: 600;
            color: #1f2937;
            horizontal-alignment: left;
        }
        
        // Form fields
        VerticalLayout {
            spacing: 20px;
            
            // Stream Title
            FormField {
                label: "Stream Title";
                LineEdit {
                    text <=> root.stream-title;
                    placeholder-text: "Enter stream title...";
                }
            }
            
            // Short Description
            FormField {
                label: "Short Description";
                LineEdit {
                    text <=> root.short-description;
                    placeholder-text: "Enter a brief description...";
                }
            }
            
            // Date/Time
            FormField {
                label: "Date / Time";
                LineEdit {
                    text <=> root.stream-date-time;
                    placeholder-text: "Select date and time...";
                }
            }
            
            // Host/Guest Info section
            Text {
                text: "Host / Guest Info";
                font-size: 16px;
                font-weight: 600;
                color: #374151;
                horizontal-alignment: left;
            }
            
            HorizontalLayout {
                spacing: 16px;
                
                VerticalLayout {
                    spacing: 8px;
                    
                    Text {
                        text: "Name";
                        font-size: 14px;
                        font-weight: 500;
                        color: #374151;
                        horizontal-alignment: left;
                    }
                    
                    LineEdit {
                        text <=> root.host-name;
                        placeholder-text: "Enter name...";
                    }
                }
                
                VerticalLayout {
                    spacing: 8px;
                    
                    Text {
                        text: "Role";
                        font-size: 14px;
                        font-weight: 500;
                        color: #374151;
                        horizontal-alignment: left;
                    }
                    
                    LineEdit {
                        text <=> root.host-role;
                        placeholder-text: "Enter role...";
                    }
                }
            }
        }
    }
}

