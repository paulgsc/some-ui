// main.slint - Main application window
import { Button, LineEdit, ComboBox } from "std-widgets.slint";
import { TabBar } from "tab_bar.slint";
import { GeneralInfoTab } from "general_info_tab.slint";
import { TopicBreakdownTab } from "topic_breakdown_tab.slint";
import { RelatedStreamsTab } from "related_streams_tab.slint";
import { SatelliteContextTab } from "satellite_context_tab.slint";

export component MainWindow inherits Window {
    title: "Livestream Context Configurator";
    preferred-width: 1200px;
    preferred-height: 800px;
    background: #f5f5f5;

    in-out property <int> current-tab: 0;
    
    // Data properties
    in-out property <string> stream-title;
    in-out property <string> short-description;
    in-out property <string> stream-date-time;
    in-out property <string> host-name;
    in-out property <string> host-role;

    VerticalLayout {
        spacing: 0px;
        
        // Main content area with card styling
        Rectangle {
            background: white;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000020;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;
            border-radius: 12px;
            
            VerticalLayout {
                padding: 32px;
                spacing: 24px;
                
                // Header
                Text {
                    text: "Livestream Context Configurator";
                    font-size: 28px;
                    font-weight: 600;
                    color: #1f2937;
                    horizontal-alignment: left;
                }
                
                // Tab navigation
                TabBar {
                    current-tab <=> root.current-tab;
                }
                
                // Tab content area
                Rectangle {
                    background: transparent;
                    
                    if root.current-tab == 0: GeneralInfoTab {
                        stream-title <=> root.stream-title;
                        short-description <=> root.short-description;
                        stream-date-time <=> root.stream-date-time;
                        host-name <=> root.host-name;
                        host-role <=> root.host-role;
                    }
                    
                    if root.current-tab == 1: TopicBreakdownTab {
                        
                    }
                    
                    if root.current-tab == 2: RelatedStreamsTab {
                        
                    }
                    
                    if root.current-tab == 3: SatelliteContextTab {
                        
                    }
                }
                
                // Navigation buttons
                HorizontalLayout {
                    alignment: space-between;
                    
                    Button {
                        text: "← Back";
                        enabled: root.current-tab > 0;
                        clicked => {
                            if (root.current-tab > 0) {
                                root.current-tab -= 1;
                            }
                        }
                    }
                    
                    Button {
                        text: root.current-tab == 3 ? "Finish" : "Next →";
                        primary: true;
                        clicked => {
                            if (root.current-tab < 3) {
                                root.current-tab += 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
