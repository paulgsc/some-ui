// related_streams_tab.slint - Related Streams tab content
import { Button, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

struct RelatedStream {
    title: string,
    date: string,
    relationship: string,
}

component RelatedStreamCard inherits Rectangle {
    in-out property <RelatedStream> stream-data;

    callback remove-clicked;

    background: #f9fafb;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e5e7eb;
    height: 100px;

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Content
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 12px;

                LineEdit {
                    text: root.stream-data.title;
                    placeholder-text: "Stream title...";
                }

                LineEdit {
                    text: root.stream-data.date;
                    placeholder-text: "Date...";
                    preferred-width: 120px;
                }
            }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: "Relationship:";
                    font-size: 14px;
                    color: #6b7280;
                    vertical-alignment: center;
                }

                ComboBox {
                    model: ["Sequel", "Prequel", "Cross-promotion", "Follow-up", "Related Topic"];
                    current-value: root.stream-data.relationship;
                }
            }
        }

        // Remove button
        Button {
            text: "✕";
            width: 32px;
            height: 32px;
            clicked => { root.remove-clicked(); }
        }
    }
}

export component RelatedStreamsTab inherits Rectangle {
    in-out property <[RelatedStream]> related-streams: [
        { title: "Previous Stream: AI Ethics", date: "2024-05-15", relationship: "Sequel" },
        { title: "Partner Stream: Tech Trends", date: "2024-05-20", relationship: "Cross-promotion" },
    ];

    background: transparent;

    VerticalLayout {
        spacing: 24px;

        // Header
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Related Streams";
                font-size: 24px;
                font-weight: 600;
                color: #1f2937;
                horizontal-alignment: left;
            }

            Button {
                text: "+ Add Related Stream";
                primary: true;
                clicked => {
                    // Add new related stream logic would go here
                }
            }
        }

        // Description
        Text {
            text: "Link this stream to other related content to provide context and improve discoverability.";
            font-size: 14px;
            color: #6b7280;
            horizontal-alignment: left;
            wrap: word-wrap;
        }

        // Related streams list
        ScrollView {
            VerticalLayout {
                spacing: 12px;

                for stream[index] in root.related-streams: RelatedStreamCard {
                    stream-data: stream;
                    remove-clicked => {
                        // Remove stream logic would go here
                    }
                }
            }
        }
    }
}
