// satellite_context_tab.slint - Satellite Context tab content
import { Button, LineEdit, ScrollView, CheckBox } from "std-widgets.slint";

struct ContextItem {
    name: string,
    type: string,
    enabled: bool,
    description: string,
}

component ContextCard inherits Rectangle {
    in-out property <ContextItem> context-data;
    
    callback remove-clicked;
    
    background: #f9fafb;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e5e7eb;
    height: 120px;
    
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        
        // Enable checkbox
        CheckBox {
            checked: root.context-data.enabled;
        }
        
        // Content
        VerticalLayout {
            spacing: 8px;
            
            HorizontalLayout {
                spacing: 12px;
                
                LineEdit {
                    text: root.context-data.name;
                    placeholder-text: "Context name...";
                }
                
                Rectangle {
                    background: #ddd6fe;
                    border-radius: 4px;
                    width: 80px;
                    height: 24px;
                    
                    Text {
                        text: root.context-data.type;
                        font-size: 12px;
                        color: #5b21b6;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            
            LineEdit {
                text: root.context-data.description;
                placeholder-text: "Description...";
            }
        }
        
        // Remove button
        Button {
            text: "✕";
            width: 32px;
            height: 32px;
            clicked => { root.remove-clicked(); }
        }
    }
}

export component SatelliteContextTab inherits Rectangle {
    in-out property <[ContextItem]> context-items: [
        { name: "Background Research", type: "Document", enabled: true, description: "Market analysis and trend data" },
        { name: "Audience Analytics", type: "Data", enabled: true, description: "Viewer demographics and preferences" },
        { name: "Competitor Analysis", type: "Report", enabled: false, description: "Similar content performance metrics" },
    ];
    
    background: transparent;
    
    VerticalLayout {
        spacing: 24px;
        
        // Header
        HorizontalLayout {
            alignment: space-between;
            
            Text {
                text: "Satellite Context";
                font-size: 24px;
                font-weight: 600;
                color: #1f2937;
                horizontal-alignment: left;
            }
            
            Button {
                text: "+ Add Context";
                primary: true;
                clicked => {
                    // Add new context item logic would go here
                }
            }
        }
        
        // Description
        Text {
            text: "Additional context, resources, and supporting materials that enhance the stream experience.";
            font-size: 14px;
            color: #6b7280;
            horizontal-alignment: left;
            wrap: word-wrap;
        }
        
        // Context items list
        ScrollView {
            VerticalLayout {
                spacing: 12px;
                
                for item[index] in root.context-items: ContextCard {
                    context-data: item;
                    remove-clicked => {
                        // Remove context item logic would go here
                    }
                }
            }
        }
        
        // Summary section
        Rectangle {
            background: #f0f9ff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #0ea5e9;
            
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                
                Text {
                    text: "Configuration Summary";
                    font-size: 16px;
                    font-weight: 600;
                    color: #0c4a6e;
                    horizontal-alignment: left;
                }
                
                Text {
                    text: "Review all settings before finalizing your livestream configuration.";
                    font-size: 14px;
                    color: #0369a1;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }
        }
    }
}


