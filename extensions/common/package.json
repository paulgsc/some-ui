{
  "dependencies": {
    "vite-tsconfig-paths": "6.1.1"
  },
  "description": "Shared Vite configuration for monorepo packages",
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@some-ui/tsconfig": "workspace:*",
    "@types/firefox-webext-browser": "^120.0.4"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./build": {
      "import": "./ext-build/types.ts",
      "types": "./ext-build/types.ts"
    },
    "./build/dev-config": {
      "import": "./ext-build/dev-config.ts",
      "types": "./ext-build/dev-config.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "bin": {
    "some-ext-build": "./ext-build/run.mjs"
  },
  "files": [
    "ext-build",
    "src"
  ],
  "keywords": [
    "vite",
    "config",
    "monorepo",
    "shared"
  ],
  "name": "@some-extension/common",
  "peerDependencies": {
    "vite": "^6.0.7"
  },
  "scripts": {
    "build:manifest": "tsx scripts/generate-manifest.ts",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "seed": "tsx src/scripts/mood-events/seed.ts",
    "test": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
