{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "declarationDir": "./",
    "composite": true,
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@common/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "ext-build/**/*.ts",
    "scripts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
