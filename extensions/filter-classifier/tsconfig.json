{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "composite": true,
    "strict": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/e2e/**/*.ts", "scripts/**/*.mjs", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "build", "tests/e2e/harness/dist"]
}
