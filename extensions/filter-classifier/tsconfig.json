{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "composite": true,
    "outDir": "./dist",
    "strict": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/e2e/**/*.ts",
    "scripts/**/*.mjs",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "tests/e2e/harness/dist"]
}
