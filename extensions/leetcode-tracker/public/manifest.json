{
  "manifest_version": 2,
  "name": "Streak Tracker",
  "version": "1.0.0",
  "description": "Track your daily LeetCode streaks",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "http://localhost:3000/*",
    "https://leetcode.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "streak-tracker@example.com",
      "strict_min_version": "91.0"
    }
  }
}
