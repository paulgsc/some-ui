{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {
    "@some-extension/common": "workspace:*"
  },
  "devDependencies": {
    "@some-ui/eslint-kit": "workspace:*",
    "@some-ui/tsconfig": "workspace:*",
    "@types/firefox-webext-browser": "143.0.1",
    "eslint": "^10.12.0",
    "vite": "^8.3.5",
    "web-ext": "10.7.0"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "name": "@some-extension/censor",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "vite build --configLoader runner",
    "build:chromium": "vite build --mode chromium --configLoader runner",
    "build:firefox": "vite build --mode firefox --configLoader runner",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "layout:crawl": "tsx scripts/crawl-layout.ts",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "package:source": "bash ../scripts/package-source.sh",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest",
    "test:e2e": "pnpm build:chromium && node scripts/patch-test-manifest.mjs && playwright test",
    "test:e2e:debug": "pnpm build:chromium && node scripts/patch-test-manifest.mjs && playwright test --debug",
    "test:e2e:headed": "pnpm build:chromium && node scripts/patch-test-manifest.mjs && playwright test --headed",
    "test:e2e:ui": "pnpm build:chromium && node scripts/patch-test-manifest.mjs && playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "1.1.0"
}
