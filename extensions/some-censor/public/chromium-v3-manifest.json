{
  "manifest_version": 3,
  "name": "BOYO - Content Censor",
  "version": "1.0.0",
  "description": "Progressive content masking with intentional disclosure",

  "permissions": ["storage", "tabs"],

  "host_permissions": ["*://*.youtube.com/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
