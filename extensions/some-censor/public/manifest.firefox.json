{
  "manifest_version": 3,
  "name": "BOYO - Content Censor",
  "description": "Progressive content masking with intentional disclosure",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "BOYO - Content Censor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "boyo-extension@local.internal",
      "strict_min_version": "112.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
