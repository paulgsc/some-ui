{
  "manifest_version": 3,
  "name": "BOYO - Content Censor",
  "description": "Progressive content masking with intentional disclosure",
  "version": "1.0.0",

  "permissions": ["storage"],

  "host_permissions": ["*://*.youtube.com/*"],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "boyo-extension@local.internal",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
