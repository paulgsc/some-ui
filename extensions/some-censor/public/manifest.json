{
  "manifest_version": 2,
  "name": "BOYO - Content Censor",
  "version": "1.0.0",
  "description": "Progressive content masking with intentional disclosure",

  "permissions": ["storage", "tabs", "*://*.youtube.com/*"],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "boyo-censor@example.com",
      "strict_min_version": "91.0"
    }
  }
}
