{
  "manifest_version": 2,
  "name": "BOYO - Content Censor",
  "version": "1.0.0",
  "description": "Progressive content masking with intentional disclosure",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "boyo-extension@local.internal"
    }
  },

  "permissions": ["storage", "tabs", "*://*.youtube.com/*"],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_end"
    }
  ],

  "browser_action": {
    "default_popup": "popup.html"
  }
}
