{
  "compilerOptions": {
    // Next to this config, not in the outDir inherited from
    // @some-ui/tsconfig (which resolves into packages/tsconfig/dist and is
    // shared by every package on that chain, #1522).
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
  },
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",

    "vite.config*.ts",

    ".playwright*/**",
    ".chromium*/**",

    "playwright-report/**",
    "test-results/**",
    "blob-report/**",

    "coverage/**",
    "dist/**",
    "build/**",
    ".next/**",
    "out/**",

    "target/**",

    "**/cjs/**",
    "**/esm/**",

    "packages/**/public/**",

    "extensions/**/test-results/**",

    "**/*.test.ts",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "tests"
  ]
}
