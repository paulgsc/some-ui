{
  "extends": "@some-ui/tsconfig/extension.json",
  "compilerOptions": {
    "paths": {
      "@censor/*": ["./src/*"],
      "@censor/playwright/*": ["./tests/e2e/*"],
      "@censor/platform/api": ["./src/lib/platform/api.ts"],
      "@censor/platform/content": ["./src/lib/platform/api.ts"],
      "@censor/platform/background": ["./src/lib/platform/api.ts"]
    },
    "types": ["firefox-webext-browser", "chrome", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "vite.config*.ts",
    "playwright.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",

    ".playwright*/**",
    ".chromium*/**",

    "playwright-report/**",
    "test-results/**",
    "blob-report/**",

    "coverage/**",
    "dist/**",
    "build/**",
    ".next/**",
    "out/**",

    "target/**",

    "**/cjs/**",
    "**/esm/**",

    "packages/**/public/**",

    "extensions/**/test-results/**"
  ]
}
