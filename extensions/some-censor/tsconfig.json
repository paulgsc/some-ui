{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    // Next to this config, not in the outDir inherited from
    // @some-ui/tsconfig (which resolves into packages/tsconfig/dist and is
    // shared by every package on that chain, #1522).
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@censor/*": ["./src/*"],
      "@censor/playwright/*": ["./tests/e2e/*"],
      "@censor/uno.config": ["./uno.config"],
      "@censor/platform/api": ["./src/lib/platform/api.ts"],
      "@censor/platform/content": ["./src/lib/platform/api.ts"],
      "@censor/platform/background": ["./src/lib/platform/api.ts"]
    },
    "types": ["firefox-webext-browser", "chrome", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "vite.config*.ts",
    "uno.config.ts",
    "playwright.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",

    ".playwright*/**",
    ".chromium*/**",

    "playwright-report/**",
    "test-results/**",
    "blob-report/**",

    "coverage/**",
    "dist/**",
    "build/**",
    ".next/**",
    "out/**",

    "target/**",

    "**/cjs/**",
    "**/esm/**",

    "packages/**/public/**",

    "extensions/**/test-results/**"
  ]
}
