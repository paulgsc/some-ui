{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {
    "@some-extension/common": "workspace:*",
    "@some-extension/transport": "workspace:*"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/eslint-kit": "workspace:*",
    "@types/firefox-webext-browser": "143.0.1",
    "vite": "^8.3.5"
  },
  "exports": {
    "./adapter/swatches": {
      "types": "./src/adapter/swatches/index.ts",
      "import": "./src/adapter/swatches/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "name": "@some-extension/filter",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "vite build --configLoader runner",
    "build:chromium": "vite build --mode chromium --configLoader runner",
    "build:firefox": "vite build --mode firefox --configLoader runner",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "dev": "vite --configLoader runner",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "package:source": "bash ../scripts/package-source.sh",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "prettier:fix": "prettier . --write",
    "test": "vitest",
    "test:claude:e2e": "bash scripts/claude-e2e.sh",
    "test:e2e": "pnpm build:chromium && playwright test",
    "test:e2e:debug": "pnpm build:chromium && playwright test --debug",
    "test:e2e:headed": "pnpm build:chromium && playwright test --headed",
    "test:e2e:ui": "pnpm build:chromium && playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "1.1.0"
}
