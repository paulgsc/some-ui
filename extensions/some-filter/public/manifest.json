{
  "manifest_version": 2,
  "name": "PDF Filter Toggle",
  "version": "1.0.0",
  "description": "Toggle a custom filter on PDFs for easier viewing.",
  "permissions": ["activeTab", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Toggle PDF Filter"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*.pdf"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "streak-tracker@example.com",
      "strict_min_version": "91.0"
    }
  }
}
