{
  "extends": "@some-ui/tsconfig/extension.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@filter/*": ["./src/*"],
      "@filter/playwright/*": ["./tests/e2e/*"],
      "@filter/platform/api": ["./src/lib/platform/api.ts"],
      "@filter/platform/content": ["./src/lib/platform/api.ts"],
      "@filter/platform/background": ["./src/lib/platform/api.ts"]
    },
    "types": ["firefox-webext-browser", "chrome", "vite/client"]
  },
  "include": [
    "src",
    "tests",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.setup.ts",
    "vitest.*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",

    ".playwright*/**",
    ".chromium*/**",

    "playwright-report/**",
    "test-results/**",
    "blob-report/**",

    "coverage/**",
    "dist/**",
    "build/**",
    ".next/**",
    "out/**",

    "target/**",

    "**/cjs/**",
    "**/esm/**",

    "packages/**/public/**",

    "extensions/**/test-results/**"
  ]
}
