{
  "manifest_version": 2,
  "name": "YouTube Session Tracker",
  "version": "1.0.0",
  "description": "Track YouTube session metadata with customizable dropdown controls",

  "permissions": ["storage", "activeTab", "https://www.youtube.com/*"],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Session Tracker"
  },

  "web_accessible_resources": ["styles/*"]
}
