{
  "extends": "@some-ui/tsconfig/tsconfig.ui.json",
  "compilerOptions": {
    // Next to this config, not in the outDir inherited from
    // @some-ui/tsconfig (which resolves into packages/tsconfig/dist and is
    // shared by every package on that chain, #1522).
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "isolatedModules": true,
    "paths": {
      "@mujik/*": ["./src/*"],
      "@mujik/playwright/*": ["./tests/e2e/*"]
    },
    "types": ["firefox-webext-browser", "chrome"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
