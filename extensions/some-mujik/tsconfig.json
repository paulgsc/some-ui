{
  "extends": "@some-ui/tsconfig/tsconfig.ui.json",
  "compilerOptions": {
    "isolatedModules": true,
    "paths": {
      "@mujik/*": ["./src/*"],
      "@mujik/playwright/*": ["./tests/e2e/*"]
    },
    "types": ["firefox-webext-browser", "chrome"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
