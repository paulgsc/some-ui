{
  "manifest_version": 2,
  "name": "YouTube Now Playing Tracker",
  "version": "1.0",
  "description": "Tracks currently playing YouTube videos and sends metadata to local server",

  "permissions": [
    "activeTab",
    "tabs",
    "https://www.youtube.com/*",
    "http://localhost:3000/*",
    "http://nixos.local:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "web_accessible_resources": ["content.js"]
}
