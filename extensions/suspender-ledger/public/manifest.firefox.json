{
  "manifest_version": 3,
  "name": "Suspender Ledger",
  "version": "0.1.0",
  "description": "Tab suspender — pause tabs to reclaim RAM without losing history.",
  "permissions": [
    "idle",
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["watch.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Suspender Ledger",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "commands": {
    "discard-tabs": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Suspend all discardable tabs"
    },
    "discard-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Suspend the active tab"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["suspend.html"],
      "matches": ["*://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "suspender-ledger@paulgsc.com",
      "strict_min_version": "109.0"
    }
  }
}
