  "manifest": {
    "manifest_version": 3,
    "name": "Suspender Ledger (Beta)",
    "description": "Beta — Tab suspender: pause background tabs to reclaim RAM without losing history or tab identity.",
    "permissions": [
      "idle",
      "storage",
      "contextMenus",
      "notifications",
      "alarms",
      "scripting",
      "tabs"
    ],
    "host_permissions": [
      "*://*/*"
    ],
    "background": {
      "scripts": [
        "worker.js"
      ]
    },
    "content_scripts": [
      {
        "matches": [
          "*://*/*"
        ],
        "js": [
          "resume-veil.js"
        ],
        "run_at": "document_start"
      },
      {
        "matches": [
          "*://*/*"
        ],
        "js": [
          "watch.js"
        ],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_title": "Suspender Ledger",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "assets/icon-16.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png"
      }
    },
    "icons": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "commands": {
      "discard-tabs": {
        "suggested_key": {
          "default": "Alt+D"
        },
        "description": "Suspend all discardable tabs"
      },
      "discard-tab": {
        "suggested_key": {
          "default": "Alt+Shift+D"
        },
        "description": "Suspend the active tab"
      }
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "browser_specific_settings": {
      "gecko": {
