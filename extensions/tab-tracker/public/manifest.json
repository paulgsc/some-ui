{
  "manifest_version": 2,
  "name": "TabLedger",
  "version": "1.0.0",
  "description": "A temporal accountability ledger for your browser tabs. Track where your time actually goes.",

  "permissions": ["storage", "tabs", "<all_urls>"],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "browser_action": {
    "default_title": "TabLedger — Open Ledger",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tabledger@local",
      "strict_min_version": "58.0"
    }
  }
}
