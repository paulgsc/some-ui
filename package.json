{
  "name": "some-ui",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "clean": "turbo clean && turbo daemon stop && rm -rf dist .turbo .rollup.cache node_modules",
    "clean:build": "turbo clean:build && turbo daemon stop && rm -rf dist",
    "build": "scripts/with-limits.sh turbo run build --filter='!./crates/*'",
    "build:crates": "scripts/with-limits.sh turbo run build --filter='./crates/*'",
    "build:unsafe": "turbo run build --filter='!./crates/*'",
    "build:template": "cargo run --manifest-path crates/pkg_cloner/Cargo.toml",
    "wasm:link": "scripts/wasm-link.sh",
    "wasm:unlink": "scripts/wasm-unlink.sh",
    "lint": "scripts/with-limits.sh turbo run lint && pnpm lint:style && pnpm check:test-layout && pnpm check:react-coordination && pnpm check:foreign-boundary && pnpm check:workflows && pnpm check:policy-docs && pnpm check:ui-manifests && pnpm check:bundle-paths",
    "lint:js": "scripts/with-limits.sh turbo run lint:js",
    "lint:style": "scripts/with-limits.sh stylelint \"**/*.css\" --allow-empty-input --cache --cache-location node_modules/.cache/.stylelintcache --ignore-path .prettierignore",
    "typecheck": "scripts/with-limits.sh turbo run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "prettier": "turbo prettier",
    "knip": "knip --no-progress --reporter compact",
    "check:bundle-paths": "scripts/with-limits.sh turbo run check:bundle-paths --filter=www",
    "check:catalog": "node scripts/check-catalog-drift.mjs",
    "check:commit-trailers": "node scripts/check-commit-trailers.ts",
    "check:foreign-boundary": "node scripts/check-foreign-boundary.ts",
    "check:policy-docs": "node scripts/check-policy-docs.ts",
    "check:react-coordination": "node scripts/check-react-coordination.ts",
    "check:test-layout": "node scripts/check-test-layout.ts",
    "report:vestiges": "node scripts/report-vestiges.ts",
    "loc:snapshot": "node scripts/loc-snapshot.ts",
    "check:ui-manifests": "tsx scripts/check-ui-manifests.ts",
    "check:workflows": "node scripts/check-workflows.ts",
    "dump:activity-catalog": "tsx scripts/dump-activity-catalog.ts",
    "dump:session-duration-policy": "tsx scripts/dump-session-duration-policy.ts",
    "prepare": "husky",
    "test": "turbo test",
    "contract": "pnpm --filter @some-ui/contract-harness contract",
    "contract:drift": "pnpm --filter @some-ui/contract-harness contract:drift"
  },
  "packageManager": "pnpm@12.9.0",
  "author": "pgdev",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "@playwright/test": "1.62.1",
    "@some-ui/eslint-kit": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.0.293",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "es-module-lexer": "3.0.2",
    "eslint": "^10.12.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jsdom": "26.0.0",
    "knip": "6.32.2",
    "lint-staged": "17.6.0",
    "prettier": "3.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "typescript-language-server": "4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
