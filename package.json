{
  "name": "some-ui",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "clean": "turbo clean && turbo daemon stop && rimraf dist && rimraf .turbo && rimraf .rollup.cache && rimraf node_modules",
    "clean:build": "turbo clean:build && turbo daemon stop && rimraf dist",
    "build": "scripts/with-limits.sh turbo run build",
    "build:unsafe": "turbo run build",
    "build-storybook": "scripts/with-limits.sh storybook build",
    "build:template": "cargo run --manifest-path crates/pkg_cloner/Cargo.toml",
    "wasm:link": "scripts/wasm-link.sh",
    "wasm:unlink": "scripts/wasm-unlink.sh",
    "dev": "turbo ready && turbo watch dev --concurrency 20",
    "docs:build": "scripts/with-limits.sh turbo run build:docs",
    "watch:build": "turbo run watch:build --parallel",
    "watch:lint": "turbo run watch:lint --parallel",
    "watch:ui": "turbo run watch --parallel --filter=scripts/packages/ui/*",
    "lint": "scripts/with-limits.sh turbo run lint && pnpm lint:style",
    "lint:fix": "scripts/with-limits.sh turbo run lint:fix -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:js": "scripts/with-limits.sh turbo run lint:js",
    "lint:md": "scripts/with-limits.sh turbo run lint:md --cache",
    "lint:style": "scripts/with-limits.sh stylelint \"**/*.css\" --allow-empty-input --cache --cache-location node_modules/.cache/.stylelintcache --ignore-path .prettierignore",
    "typecheck": "scripts/with-limits.sh turbo run typecheck",
    "prettier": "turbo prettier",
    "check-file": "turbo run check-file",
    "knip": "knip --no-progress --reporter compact",
    "prepare": "husky",
    "test": "turbo test",
    "storybook": "storybook dev -p 6006 --no-open"
  },
  "packageManager": "pnpm@10.11.1",
  "author": "pgdev",
  "devDependencies": {
    "@babel/eslint-parser": "7.26.5",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.31.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "@playwright/test": "1.60.0",
    "@some-ui/eslint-kit": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-links": "10.5.2",
    "@storybook/addon-onboarding": "10.5.2",
    "@storybook/preact-vite": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@tailwindcss/postcss": "4.1.12",
    "@tanstack/react-query": "^5.66.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/chrome": "^0.0.293",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "es-module-lexer": "2.3.0",
    "eslint": "^10.8.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-require-path-exists": "1.1.9",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-tailwindcss": "4.2.0",
    "eslint-plugin-unicorn": "^69.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^15.14.0",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "jsdom": "26.0.0",
    "knip": "6.27.0",
    "lint-staged": "15.4.3",
    "postcss": "8.5.18",
    "prettier": "3.4.2",
    "pretty-quick": "4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "6.0.1",
    "some-ui-utils": "workspace:*",
    "storybook": "10.5.2",
    "stylelint": "16.12.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-order": "6.0.4",
    "stylelint-selector-bem-pattern": "4.0.1",
    "tailwindcss": "4.1.12",
    "tailwindcss-animate": "1.0.7",
    "tsc-alias": "^1.9.1",
    "tsc-files": "^1.1.4",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "typescript-language-server": "4.3.3",
    "typescript-transform-paths": "3.5.3",
    "unocss": "^66.0.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "^4.1.10",
    "zod": "4.0.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.4",
      "@eslint/core": "0.17.0",
      "@eslint/config-helpers": "0.4.2",
      "ws": "^8.21.1"
    }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "sonner": "^2.0.7",
    "turbo": "^2.5.6"
  },
  "main": "./dist/ws.cjs.js",
  "module": "./dist/ws.es.js",
  "types": "./dist/ws.d.ts",
  "style": "./dist/some-ui.css",
  "exports": {
    ".": {
      "types": "./dist/ws.d.ts",
      "import": "./dist/ws.es.js",
      "require": "./dist/ws.cjs.js",
      "default": "./dist/ws.es.js"
    },
    "./style.css": "./dist/some-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ]
}
