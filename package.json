{
  "name": "some-ui",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "clean": "turbo clean && turbo daemon stop && rimraf dist && rimraf .turbo",
    "clean:build": "turbo clean:build && turbo daemon stop && rimraf dist",
    "build": "turbo run build",
    "dev": "turbo ready && turbo watch dev --concurrency 20",
    "docs:build": "turbo run build:docs",
    "watch:build": "turbo run watch:build --parallel",
    "watch:lint": "turbo run watch:lint --parallel",
    "watch:ui": "turbo run watch --parallel --filter=./packages/ui/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:js": "turbo run lint:js",
    "lint:md": "turbo run lint:md --cache",
    "typecheck": "turbo run typecheck",
    "prettier": "turbo prettier",
    "prepare": "husky",
    "test": "turbo test",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "packageManager": "pnpm@9.5.0",
  "author": "pgdev",
  "devDependencies": {
    "maishatu-eslint-kit": "workspace:*",
    "@babel/eslint-parser": "7.25.9",
