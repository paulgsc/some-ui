{
  "name": "some-ui",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "clean": "turbo clean && turbo daemon stop && rimraf dist && rimraf .turbo && rimraf .rollup.cache && rimraf node_modules",
    "clean:build": "turbo clean:build && turbo daemon stop && rimraf dist",
    "build": "scripts/with-limits.sh turbo run build",
    "build:unsafe": "turbo run build",
    "build:wasm": "cargo run --manifest-path crates/ujinga/Cargo.toml",
    "build-storybook": "scripts/with-limits.sh storybook build",
    "build:template": "cargo run --manifest-path crates/pkg_cloner/Cargo.toml",
    "dev": "turbo ready && turbo watch dev --concurrency 20",
    "docs:build": "scripts/with-limits.sh turbo run build:docs",
    "watch:build": "turbo run watch:build --parallel",
    "watch:lint": "turbo run watch:lint --parallel",
    "watch:ui": "turbo run watch --parallel --filter=scripts/packages/ui/*",
    "lint": "scripts/with-limits.sh turbo run lint",
    "lint:fix": "scripts/with-limits.sh turbo run lint:fix -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:js": "scripts/with-limits.sh turbo run lint:js",
    "lint:md": "scripts/with-limits.sh turbo run lint:md --cache",
    "typecheck": "scripts/with-limits.sh turbo run typecheck",
    "prettier": "turbo prettier",
    "check-file": "turbo run check-file",
    "prepare": "husky",
    "test": "turbo test",
    "storybook": "storybook dev -p 6006 --no-open"
  },
  "packageManager": "pnpm@10.11.1",
  "author": "pgdev",
  "devDependencies": {
    "@babel/eslint-parser": "7.26.5",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.11",
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "@playwright/test": "1.60.0",
    "@some-ui/styles": "workspace:*",
    "@storybook/addon-docs": "10.1.10",
    "@storybook/addon-links": "10.1.10",
    "@storybook/addon-onboarding": "10.1.10",
    "@storybook/preact-vite": "10.1.10",
    "@storybook/react-vite": "10.1.10",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/postcss": "4.1.12",
    "@tanstack/react-query": "^5.66.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/chrome": "^0.0.293",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^10.6.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-require-path-exists": "1.1.9",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-tailwindcss": "4.0.4",
    "eslint-plugin-unicorn": "^69.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^15.14.0",
    "happy-dom": "17.1.8",
    "husky": "9.1.7",
    "jsdom": "26.0.0",
    "lint-staged": "15.4.3",
    "maishatu-eslint-kit": "workspace:*",
    "postcss": "8.5.6",
    "prettier": "3.4.2",
    "pretty-quick": "4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "6.0.1",
    "storybook": "10.1.10",
    "stylelint": "16.12.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-order": "6.0.4",
    "stylelint-selector-bem-pattern": "4.0.1",
    "tailwindcss": "4.1.12",
    "tailwindcss-animate": "1.0.7",
    "tsc-alias": "^1.8.10",
    "tsc-files": "^1.1.4",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.2",
    "typescript-language-server": "4.3.3",
    "typescript-transform-paths": "3.5.3",
    "unocss": "^66.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-top-level-await": "1.5.0",
    "vite-plugin-wasm": "3.4.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.6",
    "zod": "4.0.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.4",
      "@eslint/core": "0.17.0",
      "@eslint/config-helpers": "0.4.2"
    }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "turbo": "^2.5.6"
  }
}
