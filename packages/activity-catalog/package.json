{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/types": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "fast-check": "^3.23.1"
  },
  "exports": {
    ".": {
      "types": "./dist/@some-ui/activity-catalog.d.ts",
      "import": "./dist/@some-ui/activity-catalog.es.js",
      "require": "./dist/@some-ui/activity-catalog.cjs.js",
      "default": "./dist/@some-ui/activity-catalog.es.js"
    },
    "./style.css": "./dist/activity-catalog.css"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "main": "./dist/@some-ui/activity-catalog.cjs.js",
  "module": "./dist/@some-ui/activity-catalog.es.js",
  "name": "@some-ui/activity-catalog",
  "private": true,
  "peerDependencies": {
    "@some-ui/types": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\""
  },
  "type": "module",
  "types": "./dist/@some-ui/activity-catalog.d.ts",
  "version": "0.0.1",
  "style": "./dist/activity-catalog.css",
  "sideEffects": [
    "*.css"
  ]
}
