{
  "manifest_version": 2,
  "name": "Live Typing Mirror",
  "version": "1.0.0",
  "description": "Mirror typing in real-time with floating overlay and POST on Enter",

  "permissions": [
    "activeTab",
    "storage",
    "<all_urls>",
    "http://nixos.local:3000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true,
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Typing Mirror Settings"
  },
  "web_accessible_resources": ["styles/*"]
}
