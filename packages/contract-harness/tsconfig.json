{
  "extends": "@some-ui/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": [
    "src",
    "contracts",
    "tests",
    "eslint.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
