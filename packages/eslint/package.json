{
  "name": "@some-ui/eslint-kit",
  "private": true,
  "version": "2.0.0",
  "description": "Strict ESLint flat config kit for some-ui and related repos",
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.esm.build.json && tsc-alias -p tsconfig.esm.build.json",
    "check-dist": "if [ ! -d dist ]; then pnpm run build; fi",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "gen:fixtures": "tsx scripts/gen-ts-lint-fixtures.ts",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "pnpm run check-dist && eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@some-ui/tsconfig": "workspace:*",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@types/estree": "1.0.9",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "globals": "17.13.0",
    "tsc-alias": "^1.9.9",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  }
}
