{
  "name": "maishatu-eslint-kit",
  "version": "2.0.0",
  "description": "Strict ESLint flat config kit for some-ui and related repos",
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "index.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:esm": "tsc -b tsconfig.esm.build.json",
    "build:cjs": "tsc -b tsconfig.cjs.build.json",
    "build": "pnpm build:esm",
    "check-dist": "if [ ! -d dist ]; then pnpm run build; fi",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "gen:fixtures": "tsx scripts/gen-ts-lint-fixtures.ts",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "pnpm run check-dist && eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": ">=9.22.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@some-ui/tsconfig": "workspace:*",
    "@types/eslint": "9.6.1",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@types/eslint-plugin-tailwindcss": "3.17.0",
    "@types/eslint__eslintrc": "3.3.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@typescript-eslint/utils": "^8.46.0",
    "eslint": "10.6.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-require-path-exists": "1.1.9",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-tailwindcss": "4.0.4",
    "eslint-plugin-unicorn": "69.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript-eslint": "8.59.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.10"
  }
}
