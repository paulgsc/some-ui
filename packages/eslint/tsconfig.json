{
  "extends": "@some-ui/tsconfig/eslint.tsconfig.json",
  "compilerOptions": {
    // The counted checks (site-count.ts and its users) also run on Node's
    // own type stripping (scripts/check-*.ts), which resolves an import only
    // by its real `.ts` name; the build rewrites it to `.js`.
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@eslint/*": ["./src/*"],
      // How react.lint.test.ts's import-cycle fixtures import each other: an
      // alias, as every workspace's own modules do (IC1).
      "@lint-fixtures/*": ["./tests/lint-fixtures/*"]
    }
  },
  "include": [
    "eslint.config.*.{cjs,mjs,js,ts}",
    "eslint.config.{cjs,mjs,js,ts}",
    "scripts",
    "src",
    "tests",
    "vitest.config.*.{cjs,mjs,js,ts}"
  ],
  "exclude": ["node_modules", "build", "dist", "**/lint-fixtures"]
}
