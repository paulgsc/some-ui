{
  "name": "@some-ui/job-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The files the daily jobs routine and the phone pass through Drive: the digest, decisions and scouts, with the routine's policy and a checker.",
  "license": "MIT",
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "keywords": [],
  "main": "./dist/@some-ui/job-desk.es.js",
  "module": "./dist/@some-ui/job-desk.es.js",
  "types": "./dist/@some-ui/job-desk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/job-desk.d.ts",
      "import": "./dist/@some-ui/job-desk.es.js",
      "default": "./dist/@some-ui/job-desk.es.js"
    },
    "./sample": {
      "types": "./dist/@some-ui/job-desk/sample.d.ts",
      "import": "./dist/@some-ui/job-desk/sample.es.js",
      "default": "./dist/@some-ui/job-desk/sample.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "node scripts/check.mjs",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "queue": "node scripts/queue.mjs",
    "stands": "node scripts/stands.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "*.css"
  ]
}
