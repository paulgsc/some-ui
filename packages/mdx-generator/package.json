{
  "name": "some-ui-mdx",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "build:docs": "contentlayer2 build",
    "watch": "concurrently \"rollup --bundleConfigAsCjs -c --watch\" \"tsc --watch\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:fix": "eslint --fix",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "contentlayer2": "^0.4.6",
    "lucide-react": "0.436.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "lucide-react": "0.436.0",
    "next-contentlayer2": "^0.4.6",
    "some-ui-utils": "workspace:*",
    "unist-builder": "3.0.0"
  },
  "devDependencies": {
    "@shikijs/compat": "^1.1.7",
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "concurrently": "10.0.3",
    "postcss": "^8.4.24",
    "rehype": "^12.0.1",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.6.0",
    "rehype-slug": "^5.1.0",
    "remark": "^14.0.3",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.0",
    "rimraf": "^4.1.3",
    "unist-builder": "3.0.0",
    "unist-util-visit": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "some-ui-mdx.umd.js",
  "main": "./dist/some-ui-mdx.cjs.js",
  "module": "./dist/some-ui-mdx.es.js",
  "types": "./dist/some-ui-mdx.d.ts",
  "exports": {
    ".": {
      "types": "./dist/some-ui-mdx.d.ts",
      "import": "./dist/some-ui-mdx.es.js",
      "require": "./dist/some-ui-mdx.cjs.js",
      "default": "./dist/some-ui-mdx.es.js"
    },
    "./style.css": "./dist/some-ui-mdx.css"
  },
  "style": "./dist/some-ui-mdx.css"
}
