{
  "name": "some-ui-mdx",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "build": "rollup --bundleConfigAsCjs -c --no-cache && pnpm build:tsc-alias",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "build:docs": "contentlayer2 build",
    "watch": "rollup --bundleConfigAsCjs -c --watch & tsc --watch",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:fix": "eslint --fix",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": "0.436.0",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "contentlayer2": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "some-ui-shared": "workspace:*",
    "some-ui-utils": "workspace:*",
    "zod": "3.23.8",
    "unist-builder": "3.0.0",
    "lucide-react": "0.436.0",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "next-contentlayer2": "^0.4.6"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "postcss": "^8.4.24",
    "rehype": "^12.0.1",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.6.0",
    "rehype-slug": "^5.1.0",
    "remark": "^14.0.3",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.0",
    "rimraf": "^4.1.3",
    "unist-builder": "3.0.0",
    "unist-util-visit": "^4.1.2",
    "@shikijs/compat": "^1.1.7",
    "@some-ui/tsconfig": "workspace:*",
    "some-ui-rollup-config": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "some-ui-mdx*",
    "./dist/src/**/*",
    "index.d.ts",
    "./dist/esm/**/*",
    "./dist/cjs/**/*"
  ],
  "sideEffects": false,
  "unpkg": "some-ui-mdx.umd.js",
  "main": "./dist/some-ui-mdx.umd.js",
  "module": "./dist/esm/some-ui-mdx.esm.js",
  "types": "index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/some-ui-mdx.esm.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/some-ui-mdx.cjs.js"
      }
    }
  }
}
