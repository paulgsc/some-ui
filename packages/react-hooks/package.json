{
  "name": "@some-ui/react-hooks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "React hooks with more than one genuine consumer: the handheld breakpoint, the fitted page, the resize observer and show-on-scroll-up.",
  "license": "MIT",
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "keywords": [],
  "main": "./dist/@some-ui/react-hooks.es.js",
  "module": "./dist/@some-ui/react-hooks.es.js",
  "types": "./dist/@some-ui/react-hooks.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/react-hooks.d.ts",
      "import": "./dist/@some-ui/react-hooks.es.js",
      "default": "./dist/@some-ui/react-hooks.es.js"
    },
    "./style.css": "./dist/react-hooks.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "fast-check": "^4.10.2",
    "jsdom": "26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "style": "./dist/react-hooks.css",
  "sideEffects": [
    "*.css"
  ]
}
