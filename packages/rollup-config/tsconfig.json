{
  "extends": "../tsconfig/rollupconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
        "module": "preserve",
            "target": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src", "index.ts"],
  "exclude": ["node_modules", "build", "dist"]
}
