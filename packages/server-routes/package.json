{
  "name": "@some-ui/server-routes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The server's HTTP route surface (ServerRoute / UnversionedRoute), generated by paulgsc/server's `dump-routes -- --ts` and checked in verbatim. Holds nothing else, so neither the runtime package that consumes it (fetch-kit) nor the test-time one (contract-harness) has to depend on the other to get it.",
  "scripts": {
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier . --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
