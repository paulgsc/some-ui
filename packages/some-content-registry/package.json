{
  "dependencies": {
    "@some-ui/types": "workspace:*",
    "@some-ui/topik": "workspace:*",
    "@some-ui/honeycomb": "workspace:*",
    "@some-ui/leetype": "workspace:*",
    "some-ui-utils": "workspace:*"
  },
  "description": "Scene registry, layout orchestration, and other content-driven logic for the monorepo's activities. Pairs with @some-ui/content, which holds the actual assets/data this package registers and orchestrates.",
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "keywords": [
    "vite",
    "config",
    "monorepo",
    "shared"
  ],
  "name": "@some-ui/content-registry",
  "private": true,
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "scripts": {
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist ./tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.7"
}
