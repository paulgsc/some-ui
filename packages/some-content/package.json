{
  "dependencies": {
    "attributions": "workspace:*",
    "maishatu-fetch-kit": "workspace:*",
    "some-ui-nfl": "workspace:*",
    "some-ui-stepper": "workspace:*",
    "some-ui-utils": "workspace:*",
    "some-ui-input": "workspace:*",
    "some-ui-slideshow": "workspace:*",
    "some-ui-honeycomb": "workspace:*",
    "portfolio-chart": "workspace:*",
    "some-types-utils": "workspace:*",
    "makjang": "workspace:*",
    "umag": "workspace:*",
    "some-ui-neon-sign": "workspace:*",
    "some-ui-chat": "workspace:*"
  },
  "description": "Shared Vite configuration for monorepo packages",
  "devDependencies": {
    "node-fetch": "^3.3.2",
    "@types/node-fetch": "^2.6.11",
    "@some-ui/tsconfig": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "keywords": [
    "vite",
    "config",
    "monorepo",
    "shared"
  ],
  "name": "@some-ui/content",
  "peerDependencies": {
    "vite": "^6.0.7"
  },
  "scripts": {
    "seed": "tsx src/scripts/mood-events/seed.ts",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
