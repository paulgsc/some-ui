{
  "name": "@some-ui/styles",
  "private": true,
  "version": "1.0.0",
  "description": "Shared design system (UnoCSS preset + shadcn tokens/themes) for the some-ui monorepo",
  "type": "module",
  "keywords": [
    "some",
    "unocss",
    "design-system",
    "shadcn",
    "css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset/index.ts",
    "./config": "./src/config.ts",
    "./uno.config": "./uno.config.ts",
    "./tokens.css": "./tokens/base.css",
    "./tailwind.css": "./tailwind.css",
    "./themes.css": "./themes.css",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "build:css": "unocss \"examples/**/*.{html,ts,tsx}\" --config uno.config.ts --out-file dist/some-ui.css",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm prettier && pnpm typecheck",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "unocss": "^66.0.0"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@types/node": "^26.0.1",
    "@unocss/cli": "^66.0.0",
    "unocss": "^66.0.0"
  }
}
