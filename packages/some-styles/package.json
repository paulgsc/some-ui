{
  "name": "@some-ui/styles",
  "private": true,
  "version": "1.0.0",
  "description": "Shared design system (UnoCSS preset + shadcn tokens/themes) for the some-ui monorepo",
  "type": "module",
  "keywords": [
    "some",
    "unocss",
    "design-system",
    "shadcn",
    "css"
  ],
  "bin": {
    "some-styles-build": "./styles-build/run.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./preset": "./src/preset/index.ts",
    "./config": "./src/config.ts",
    "./uno.config": "./uno.config.ts",
    "./styles-build": "./styles-build/types.ts",
    "./styles-build/compile": "./styles-build/compile.mjs",
    "./styles-build/dev-config": "./styles-build/dev-config.ts",
    "./tokens.css": "./tokens/base.css",
    "./tailwind.css": "./tailwind.css",
    "./themes.css": "./themes.css",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "build:css": "unocss \"examples/**/*.{html,ts,tsx}\" --config uno.config.ts --out-file dist/some-ui.css",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm prettier && pnpm typecheck",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "jiti": "2.7.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.12",
    "tailwindcss-animate": "1.0.7"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "unocss": "^66.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "^26.0.1",
    "@unocss/cli": "^66.8.1",
    "unocss": "^66.0.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "happy-dom": "20.10.6"
  }
}
