{
  "name": "@some-ui/vite-config",
  "private": true,
  "version": "1.0.0",
  "description": "Shared Vite configuration for monorepo packages",
  "type": "module",
  "main": "./dist/esm/src/index.js",
  "types": "src/index.ts",
  "files": [
    "dist/**",
    "src/audience/client.d.ts"
  ],
  "keywords": [
    "vite",
    "config",
    "monorepo",
    "shared"
  ],
  "scripts": {
    "build": "tsc --outDir dist/esm && tsc-alias -p tsconfig.tsc-alias.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist ./tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "tsc-alias": "^1.9.5"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "require": "./dist/esm/src/index.js"
    },
    "./lib": {
      "import": "./dist/esm/src/lib/index.js",
      "require": "./dist/esm/src/lib/index.js"
    },
    "./audience": {
      "types": "./dist/esm/src/audience/index.d.ts",
      "import": "./dist/esm/src/audience/index.js",
      "require": "./dist/esm/src/audience/index.js"
    },
    "./build-profile-client": {
      "types": "./src/audience/client.d.ts"
    }
  }
}
