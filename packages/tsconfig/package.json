{
  "name": "@some-ui/tsconfig",
  "version": "0.1.0",
  "description": "tsconfig for some-ui",
  "private": true,
  "scripts": {
    "clean": "rm -rf ./dist ./.turbo ./node_modules ./.eslintcache",
    "clean:build": "rm -rf ./dist",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\""
  }
}
