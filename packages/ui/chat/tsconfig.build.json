{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "incremental": true,
    "tsBuildInfoFile": "./dist/types/tsconfig.build.tsbuildinfo",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "vite.config*.ts",
    "vitest.*.ts",
    "../../../assets/**/*",
    "**/data/chat-messages.ts",
    "**/data/index.ts",
    "**/demo/**",
    "../../some-content/src/**/*"
  ]
}
