{
  "extends": "../../tsconfig/rollupconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "rootDir": "../../../",
    "outDir": "./dist",
    "declaration": true,
    "paths": {
      "@chat/*": ["./src/*"],
      "@some-ui/*": ["../../../assets/*"],
      "@some-ui/content/*": ["../../some-content/src/*"],
      "@some-ui/content": ["../../../some-content/src"]
    }
  },
  "include": [
    "tailwind.config.ts",
    "eslint.config.js",
    "../../../assets/**/*",
    "src",
    "../../some-content/src/**/*"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
