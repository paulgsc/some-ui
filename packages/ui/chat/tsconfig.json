{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "rootDir": "../../../",
    "outDir": "./dist",
    "declaration": true,
    "paths": {
      "@chat/*": ["./src/*"],
      "@some-ui/*": ["../../../assets/*"],
      "@some-ui/content-registry/*": ["../../some-content-registry/src/*"],
      "@some-ui/content-registry": ["../../some-content-registry/src"]
    }
  },
  "include": [
    "tailwind.config.ts",
    "eslint.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "test",
    "../../../assets/**/*",
    "src",
    "../../some-content-registry/src/**/*"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
