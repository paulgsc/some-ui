{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "incremental": true,
    "tsBuildInfoFile": "./dist/types/tsconfig.build.tsbuildinfo",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["**/*.stories.tsx", "**/*.stories.ts", "**/demo/**"]
}
