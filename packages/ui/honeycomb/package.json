{
  "name": "@some-ui/honeycomb",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "watch": "concurrently \"rollup --bundleConfigAsCjs -c --watch\" \"tsc --watch\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@some-ui/styles": "workspace:*",
    "@some-ui/wasm-loader": "workspace:*",
    "@some-ui/hangul-game-core": "workspace:*",
    "@some-ui/fetch-kit": "workspace:*",
    "@some-ui/some-hexagon": "workspace:*",
    "some-ui-shared": "workspace:*",
    "some-ui-utils": "workspace:*",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "concurrently": "10.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "some-ui-honeycomb.umd.js",
  "main": "./dist/some-ui-honeycomb.cjs.js",
  "module": "./dist/some-ui-honeycomb.es.js",
  "types": "./dist/some-ui-honeycomb.d.ts",
  "exports": {
    ".": {
      "types": "./dist/some-ui-honeycomb.d.ts",
      "import": "./dist/some-ui-honeycomb.es.js",
      "require": "./dist/some-ui-honeycomb.cjs.js",
      "default": "./dist/some-ui-honeycomb.es.js"
    },
    "./style.css": "./dist/honeycomb.css"
  },
  "style": "./dist/honeycomb.css"
}
