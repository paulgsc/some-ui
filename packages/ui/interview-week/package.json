{
  "name": "@some-ui/interview-week",
  "private": true,
  "version": "0.0.1",
  "description": "The interview week: a mock interview and teleprompter reads by voice, then an essay on how I communicated. It holds the week's format, the Monday routine that writes it, the measured faults of a take (fillers, pauses, mumbling, pace, length, misreads) and the shape of the judged ones.",
  "type": "module",
  "someUi": {
    "audience": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "monday": "tsx scripts/monday.ts"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/eslint-kit": "workspace:*",
    "@some-ui/video-render": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "fast-check": "^4.10.2",
    "tsx": "^4.22.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/@some-ui/interview-week.es.js",
  "module": "./dist/@some-ui/interview-week.es.js",
  "types": "./dist/@some-ui/interview-week.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/interview-week.d.ts",
      "import": "./dist/@some-ui/interview-week.es.js",
      "default": "./dist/@some-ui/interview-week.es.js"
    }
  }
}
