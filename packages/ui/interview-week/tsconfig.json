{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "declarationDir": "./",
    "rootDir": ".",
    // scripts/monday.ts reads `@some-ui/eslint-kit/calls` as source
    // (packages/eslint/tsconfig.json); src never imports it.
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@interview-week/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "src/**/*.json",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
