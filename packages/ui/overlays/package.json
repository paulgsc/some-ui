{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {
    "attributions": "workspace:*",
    "@some-ui/makjang": "workspace:*",
    "portfolio-chart": "workspace:*",
    "react-d3-tree": "3.6.2",
    "react-resizable-panels": "^2.1.0",
    "some-types-utils": "workspace:*",
    "@some-ui/calendar": "workspace:*",
    "some-ui-chat": "workspace:*",
    "some-ui-emoji-animations": "workspace:*",
    "some-ui-input": "workspace:*",
    "some-ui-nfl": "workspace:*",
    "some-ui-slideshow": "workspace:*",
    "some-ui-stepper": "workspace:*",
    "some-ui-shared": "workspace:*",
    "some-ui-utils": "workspace:*",
    "umag": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "wireframes": "workspace:*"
  },
  "devDependencies": {
    "@some-ui/content": "workspace:*",
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.es.js",
      "require": "./dist/overlays.cjs.js",
      "default": "./dist/overlays.es.js"
    },
    "./style.css": "./dist/overlays.css"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "main": "./dist/overlays.cjs.js",
  "module": "./dist/overlays.es.js",
  "name": "overlays",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache",
    "typecheck": "tsc --noEmit",
    "watch:build": "rollup --bundleConfigAsCjs -c --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\""
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "types": "./dist/overlays.d.ts",
  "unpkg": "overlays.umd.js",
  "version": "0.0.5",
  "style": "./dist/overlays.css"
}
