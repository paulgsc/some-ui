{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "declarationDir": "./",
    "composite": true,
    "rootDir": "../../../",
    "outDir": "./dist",
    "paths": {
      "@overlays/*": ["./src/*"],
      "@some-ui/*": ["../../../assets/*"],
      "@some-ui/content/*": ["../../some-content/src/*"],
      "@some-ui/content": ["../../../some-content/src"]
    }
  },
  "include": [
    "eslint.config.js",
    "tailwind.config.ts",
    "src",
    "../../../assets/**/*",
    "../../some-content/src/**/*"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
