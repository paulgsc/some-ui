{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {
    "@types/d3-shape": "^3.1.7",
    "d3-shape": "^3.2.0",
    "framer-motion": "12.4.7",
    "lucide-react": "^0.477.0",
    "recharts": "2.12.7",
    "some-charts": "link:../../../crates/some-charts/dist",
    "some-ui-shared": "workspace:*",
    "some-ui-utils": "1.1.0"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "zod": "^3.24.1"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/portfolio-chart.esm.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/portfolio-chart.cjs.js"
      }
    }
  },
  "files": [
    "portfolio-chart*",
    "./dist/src/**/*",
    "index.d.ts",
    "./dist/esm/**/*",
    "./dist/cjs/**/*"
  ],
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "main": "./dist/portfolio-chart.umd.js",
  "module": "./dist/esm/portfolio-chart.esm.js",
  "name": "portfolio-chart",
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "rollup --bundleConfigAsCjs -c --no-cache && pnpm build:tsc-alias",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "watch": "rollup --bundleConfigAsCjs -c --watch & tsc --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\""
  },
  "sideEffects": false,
  "type": "module",
  "types": "index.d.ts",
  "unpkg": "portfolio-chart.umd.js",
  "version": "0.0.5"
}
