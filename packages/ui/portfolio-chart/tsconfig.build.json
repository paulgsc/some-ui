{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "incremental": true,
    "tsBuildInfoFile": "./dist/types/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "tailwind.config.ts",
    "eslint.config.js",
    "vite.config.ts",
    "setupVitest.ts",
    "../../../assets/**/*",
    "src/data",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/*.test.ts"
  ]
}
