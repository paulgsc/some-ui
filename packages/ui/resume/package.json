{
  "name": "@some-ui/resume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs && pnpm export:data && tsc -p tsconfig.build.json && vite build",
    "watch": "node scripts/compile.mjs --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf ./documents && rimraf tsconfig.build.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,json}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "check:ats": "node scripts/check-ats.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "export:data": "node scripts/export-data.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@types/react": "^19.0.4"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*"
  },
  "main": "./dist/some-ui-resume.cjs.js",
  "module": "./dist/some-ui-resume.es.js",
  "types": "./dist/some-ui-resume.d.ts",
  "style": "./dist/resume.css",
  "exports": {
    ".": {
      "types": "./dist/some-ui-resume.d.ts",
      "import": "./dist/some-ui-resume.es.js",
      "require": "./dist/some-ui-resume.cjs.js",
      "default": "./dist/some-ui-resume.es.js"
    },
    "./style.css": "./dist/resume.css"
  },
  "sideEffects": [
    "*.css"
  ]
}
