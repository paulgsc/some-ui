{
  "name": "@some-ui/resume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs",
    "watch": "node scripts/compile.mjs --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist",
    "lint": "pnpm lint:js && pnpm prettier",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,md,json}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
