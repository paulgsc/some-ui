{
  "name": "@some-ui/rust-rounds",
  "private": true,
  "version": "0.0.1",
  "description": "Rust Rounds: the round, log and tutor-notes formats any tutor writes to and the phone reads, the intake that takes a tutor's reply, the copy that asks a tutor for the next round, and the phone session: open it, stay, leave.",
  "type": "module",
  "someUi": {
    "audience": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/shared": "workspace:*",
    "lucide-react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@types/react": "^19.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/@some-ui/rust-rounds.es.js",
  "module": "./dist/@some-ui/rust-rounds.es.js",
  "types": "./dist/@some-ui/rust-rounds.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/rust-rounds.d.ts",
      "import": "./dist/@some-ui/rust-rounds.es.js",
      "default": "./dist/@some-ui/rust-rounds.es.js"
    },
    "./entry": {
      "types": "./dist/@some-ui/rust-rounds/entry.d.ts",
      "import": "./dist/@some-ui/rust-rounds/entry.es.js",
      "default": "./dist/@some-ui/rust-rounds/entry.es.js"
    }
  }
}
