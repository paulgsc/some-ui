{
  "name": "@some-ui/slideshow",
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.build.json",
    "watch": "rollup --bundleConfigAsCjs -c --watch & tsc --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "framer-motion": "^12.4.10",
    "lucide-react": "^0.474.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "maishatu-fetch-kit": "workspace:*",
    "some-types-utils": "workspace:*",
    "some-ui-neon-sign": "workspace:*",
    "some-ui-shared": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "some-ui-utils": "workspace:*",
    "umag": "workspace:*"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "@some-ui/slideshow.umd.js",
  "main": "./dist/@some-ui/slideshow.cjs.js",
  "module": "./dist/@some-ui/slideshow.es.js",
  "types": "./dist/@some-ui/slideshow.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/slideshow.d.ts",
      "import": "./dist/@some-ui/slideshow.es.js",
      "require": "./dist/@some-ui/slideshow.cjs.js",
      "default": "./dist/@some-ui/slideshow.es.js"
    },
    "./style.css": "./dist/@some-ui/slideshow.css"
  },
  "style": "./dist/@some-ui/slideshow.css"
}
