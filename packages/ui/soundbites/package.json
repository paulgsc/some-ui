{
  "name": "@some-ui/soundbites",
  "private": true,
  "version": "0.0.1",
  "description": "Say why you skipped a session, out loud: a capped, on-phone soundbite recorder for the Android app.",
  "type": "module",
  "someUi": {
    "audience": "apk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/shared": "workspace:*",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@types/react": "^19.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "@some-ui/soundbites.umd.js",
  "main": "./dist/@some-ui/soundbites.es.js",
  "module": "./dist/@some-ui/soundbites.es.js",
  "types": "./dist/@some-ui/soundbites.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/soundbites.d.ts",
      "import": "./dist/@some-ui/soundbites.es.js",
      "default": "./dist/@some-ui/soundbites.es.js"
    },
    "./style.css": "./dist/soundbites.css",
    "./contract": {
      "types": "./dist/@some-ui/soundbites/contract.d.ts",
      "import": "./dist/@some-ui/soundbites/contract.es.js",
      "default": "./dist/@some-ui/soundbites/contract.es.js"
    }
  },
  "style": "./dist/soundbites.css"
}
