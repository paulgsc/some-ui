{
  "name": "@some-ui/topik",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "someUi": {
    "audience": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check:deck": "node scripts/check-deck.mjs",
    "check:drama": "node scripts/check-drama.mjs",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "clean": "rm -rf .turbo node_modules .eslintcache && pnpm clean:build",
    "clean:build": "rm -rf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/intent-kit": "workspace:*",
    "@some-ui/makjang": "workspace:*",
    "@some-ui/react-hooks": "workspace:*",
    "@some-ui/shared": "workspace:*",
    "@some-ui/speech": "workspace:*",
    "@some-ui/styles": "workspace:*",
    "@tanstack/react-query": "^5.66.11",
    "lucide-react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@types/react": "^19.0.4",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/@some-ui/topik.es.js",
  "module": "./dist/@some-ui/topik.es.js",
  "types": "./dist/@some-ui/topik.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@some-ui/topik.d.ts",
      "import": "./dist/@some-ui/topik.es.js",
      "default": "./dist/@some-ui/topik.es.js"
    },
    "./style.css": "./dist/topik.css"
  },
  "style": "./dist/topik.css"
}
