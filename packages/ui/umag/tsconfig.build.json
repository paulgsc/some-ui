{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "incremental": true,
    "tsBuildInfoFile": "./dist/types/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/demo/**",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
