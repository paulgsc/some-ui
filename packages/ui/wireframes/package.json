{
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/shared": "workspace:*",
    "@some-ui/types": "workspace:*",
    "lucide-react": "catalog:",
    "sonner": "^2.0.7",
    "zod": "catalog:",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "fast-check": "^4.10.2"
  },
  "exports": {
    ".": {
      "types": "./dist/wireframes.d.ts",
      "import": "./dist/wireframes.es.js",
      "default": "./dist/wireframes.es.js"
    },
    "./style.css": "./dist/wireframes.css"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "keywords": [],
  "license": "MIT",
  "main": "./dist/wireframes.es.js",
  "module": "./dist/wireframes.es.js",
  "name": "wireframes",
  "private": true,
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist ./tsconfig.build.tsbuildinfo ./tsconfig.tsbuildinfo",
    "knip": "knip --directory \"$(git rev-parse --show-toplevel)\" --workspace \"$(git rev-parse --show-prefix | sed 's:/*$::')\"",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\""
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "someUi": {
    "audience": "public"
  },
  "types": "./dist/wireframes.d.ts",
  "unpkg": "wireframes.umd.js",
  "version": "0.0.11",
  "style": "./dist/wireframes.css"
}
