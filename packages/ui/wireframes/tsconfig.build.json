{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "incremental": true,
    "tsBuildInfoFile": "./dist/types/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.property.test.ts",
    "**/__tests__/**",
    "../../../assets/**/*",
    "**/data/**",
    "**/demo/**",
    "../../some-content/src/**/*",
    "../../some-content-registry/src/**/*",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
