{
  "extends": "@some-ui/tsconfig/rollupconfig.json",
  "compilerOptions": {
    "declarationDir": "./",
    "composite": true,
    "rootDir": "../../../",
    "outDir": "./dist",
    "paths": {
      "@wireframes/*": ["./src/*"],
      "@some-ui/content-registry/*": ["../../some-content-registry/src/*"],
      "@some-ui/content-registry": ["../../some-content-registry/src"]
    }
  },
  "include": [
    "src",
    "../../some-content-registry/src/**/*",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
