{
  "name": "some-ui-utils",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo .rollup.cache",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.66.11",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.4.0",
    "usehooks-ts": "3.1.0",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/fetch-kit": "workspace:*",
    "@some-ui/wasm-loader": "workspace:*",
    "@some-ui/ws": "workspace:*",
    "clsx": "^2.1.1",
    "@some-ui/polyhedron": "0.0.4",
    "@some-ui/types": "workspace:*",
    "tailwind-merge": "^2.4.0",
    "usehooks-ts": "3.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@tanstack/react-query": "^5.66.11",
    "@testing-library/react": "^16.3.0",
    "fast-check": "^3.23.1",
    "jsdom": "26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
