{
  "name": "some-ui-utils",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:tsc-alias": "tsc-alias -p tsconfig.json",
    "watch:build": "rollup --bundleConfigAsCjs -c --watch",
    "watch:lint": "eslint --watch --cache --fix \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf .eslintcache && pnpm clean:build",
    "clean:build": "rimraf ./dist && rimraf rimraf tsconfig.tsbuildinfo && rimraf .rollup.cache",
    "lint": "pnpm lint:js && pnpm prettier && pnpm typecheck",
    "lint:js": "cross-env NODE_OPTIONS='--max_old_space_size=4096' eslint \"**/*.{js,mjs,ts,tsx}\" --cache",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --ignore-path $(git rev-parse --show-toplevel)/.prettierignore --check --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.66.11",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.4.0",
    "usehooks-ts": "3.1.0",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "@some-ui/core-utils": "workspace:*",
    "@some-ui/fetch-kit": "workspace:*",
    "@some-ui/wasm-loader": "workspace:*",
    "@some-ui/ws": "workspace:*",
    "clsx": "^2.1.1",
    "@some-ui/polyhedron": "0.0.4",
    "some-types-utils": "workspace:*",
    "tailwind-merge": "^2.4.0",
    "usehooks-ts": "3.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@some-ui/tsconfig": "workspace:*",
    "@some-ui/vite-config": "workspace:*",
    "@tanstack/react-query": "^5.66.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulgsc/some-ui"
  },
  "bugs": {
    "url": "https://github.com/paulgsc/some-ui/issues"
  },
  "homepage": "https://pgdev.maishatu.com/?tab=github",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "some-ui-utils.umd.js",
  "main": "./dist/some-ui-utils.cjs.js",
  "module": "./dist/some-ui-utils.es.js",
  "types": "./dist/some-ui-utils.d.ts",
  "exports": {
    ".": {
      "types": "./dist/some-ui-utils.d.ts",
      "import": "./dist/some-ui-utils.es.js",
      "require": "./dist/some-ui-utils.cjs.js",
      "default": "./dist/some-ui-utils.es.js"
    },
    "./style.css": "./dist/some-ui-utils.css"
  },
  "style": "./dist/some-ui-utils.css"
}
