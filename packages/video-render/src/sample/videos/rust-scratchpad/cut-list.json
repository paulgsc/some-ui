{
  "schema": "some-ui.cut-list/2",
  "title": "Rust scratchpad",
  "series": {
    "id": "cheat-sheet",
    "version": 1
  },
  "look": "plain",
  "voice": "read",
  "shots": [
    {
      "id": "C1",
      "picture": {
        "kind": "card"
      },
      "durationMs": 11300,
      "burnIns": [
        {
          "kind": "flow",
          "params": {
            "kicker": "FLOW · OPEN AND CLOSE",
            "title": "prefix S, write, quit, gone",
            "steps": [
              {
                "badge": "main",
                "label": "prefix S",
                "note": "A tmux window named scratch."
              },
              {
                "badge": "main",
                "label": "A dir in tmpfs",
                "note": "main.rs and a rust-project.json, so rust-analyzer works with no Cargo.toml."
              },
              {
                "badge": "main",
                "label": "Vim + a watch pane",
                "note": "The right pane compiles, lints and runs on every save."
              },
              {
                "badge": "main",
                "label": "Quit vim",
                "note": "The directory and the pane go. Nothing is kept: copy out first."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C2",
      "picture": {
        "kind": "card"
      },
      "durationMs": 13600,
      "burnIns": [
        {
          "kind": "terminal",
          "params": {
            "kicker": "TERMINAL · THE SHELL",
            "title": "What the binding runs, and the commands inside",
            "bar": "nix develop · scratchpad",
            "lines": [
              {
                "prompt": "$",
                "keyword": "nix develop github:paulgsc/scratch#scratchpad -c scratch"
              },
              {
                "comment": "# the toolchain lives only in this dev shell, never in NixOS or home;"
              },
              {
                "comment": "# the first run downloads it, later runs reuse it until a GC",
                "badge": "main"
              },
              {
                "prompt": "$",
                "keyword": "scratch run foo.rs",
                "comment": "     # rustc + clippy, then run it if it compiles"
              },
              {
                "prompt": "$",
                "keyword": "scratch watch foo.rs",
                "comment": "   # the same on every save"
              },
              {
                "prompt": "$",
                "keyword": "scratch check -",
                "comment": "        # lint only: rustc's JSON diagnostics"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C3",
      "picture": {
        "kind": "card"
      },
      "durationMs": 12450,
      "burnIns": [
        {
          "kind": "cheat-sheet",
          "params": {
            "kicker": "CHEAT SHEET · IN VIM",
            "title": "Inside the editor",
            "rows": [
              {
                "badge": "main",
                "task": "Compile and run",
                "command": "\\r   or   :make",
                "note": "Errors go to the quickfix list, output below them."
              },
              {
                "badge": "main",
                "task": "Lints as you type",
                "command": "rust-analyzer + scratch check -"
              },
              {
                "badge": "main",
                "task": "Another file",
                "command": ":e other.rs",
                "note": "Its own crate on first save; the pane runs the file saved last."
              },
              {
                "badge": "gap",
                "task": "Crates",
                "command": "std only"
              },
              {
                "badge": "main",
                "task": "Outside tmux",
                "command": "vim alone",
                "note": "No watch pane; \\r still runs it."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C4",
      "picture": {
        "kind": "card"
      },
      "durationMs": 11300,
      "burnIns": [
        {
          "kind": "cheat-sheet",
          "params": {
            "kicker": "CHEAT SHEET · WHEN IT ISN'T WHAT YOU EXPECT",
            "title": "nano, a stale copy, a lost binding",
            "rows": [
              {
                "badge": "main",
                "task": "nano opens",
                "command": "vim, always",
                "note": "NixOS makes nano the default EDITOR; scratch#2 stopped reading it."
              },
              {
                "badge": "main",
                "task": "Another editor",
                "command": "SCRATCH_EDITOR=…",
                "note": "Only on purpose: \\r and the watch pane live in vim."
              },
              {
                "badge": "you",
                "task": "nano still opens",
                "command": "--refresh (next card)",
                "note": "Nix is still running a copy from before scratch#2."
              },
              {
                "badge": "gap",
                "task": "prefix r after an upgrade",
                "command": "tmux source-file",
                "note": "prefix r reads ~/.tmux.conf; home-manager writes ~/.config/tmux/tmux.conf (dotfiles#66)."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C5",
      "picture": {
        "kind": "card"
      },
      "durationMs": 13600,
      "burnIns": [
        {
          "kind": "terminal",
          "params": {
            "kicker": "TERMINAL · PAST NIX'S CACHE",
            "title": "Take a new main, and reload tmux",
            "bar": "your shell",
            "lines": [
              {
                "prompt": "$",
                "keyword": "nix develop --refresh github:paulgsc/scratch#scratchpad -c true"
              },
              {
                "comment": "# Nix reuses its last fetch for an hour (tarball-ttl): this looks now",
                "badge": "main"
              },
              {
                "comment": "# the toolchain moves only with flake.lock, never on a refresh"
              },
              {
                "comment": "# without --refresh, it fetches the toolchain ahead of prefix S",
                "badge": "you"
              },
              {
                "prompt": "$",
                "keyword": "tmux source-file ~/.config/tmux/tmux.conf"
              },
              {
                "comment": "# after an upgrade, so prefix S is bound: not prefix r",
                "badge": "you"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C6",
      "picture": {
        "kind": "card"
      },
      "durationMs": 12450,
      "burnIns": [
        {
          "kind": "legend",
          "params": {
            "kicker": "LEGEND",
            "title": "Reading the badges"
          }
        }
      ]
    },
    {
      "id": "C7",
      "picture": {
        "kind": "card"
      },
      "durationMs": 10150,
      "burnIns": [
        {
          "kind": "rule",
          "params": {
            "kicker": "FRESHNESS",
            "title": "How stale is this card?",
            "sources": ["the scratch README", "the code"],
            "wins": "the README"
          }
        }
      ]
    }
  ],
  "burnIns": [],
  "stamp": {
    "sources": ["paulgsc/scratch@35ae1e0", "paulgsc/dotfiles@91cb11b"],
    "date": "2026-11-14"
  }
