{
  "extends": "@some-ui/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "types": ["node"],
    "rootDir": ".",
    "resolveJsonModule": true,
    "paths": {
      "@video-render/*": ["./src/*"]
    }
  },
  "include": ["src", "src/**/*.json", "eslint.config.js", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
