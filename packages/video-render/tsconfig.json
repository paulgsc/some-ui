{
  "extends": "@some-ui/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    // The calls record's loader (`@some-ui/eslint-kit/calls`) is read as
    // source, and imports its rules by their real `.ts` name, as Node's
    // type stripping needs (packages/eslint/tsconfig.json).
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "rootDir": ".",
    "resolveJsonModule": true,
    "paths": {
      "@video-render/*": ["./src/*"]
    }
  },
  "include": ["src", "src/**/*.json", "eslint.config.js", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
