      "burnIns": [],
      "spoken": {
        "role": "scene",
        "narration": "Its main workflow ran for fifteen and a half minutes of wall time, and thirty-three runner-minutes in all. The Rust build, the Rust tests and four Rust dependency audits all ran, and all passed. The pull request touched no Rust, so none of them could have failed."
      },
      "durationMs": 21100
    },
