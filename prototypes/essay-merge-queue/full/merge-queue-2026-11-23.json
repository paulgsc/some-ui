      "burnIns": [],
      "spoken": {
        "role": "scene",
        "chapter": "Chapter one. The pain.",
        "narration": "Start with one small pull request. It adds three records of decisions and one line to a ledger. Four JSON files, sixty-one lines, and no code at all."
      },
      "durationMs": 13800
    },
    {
