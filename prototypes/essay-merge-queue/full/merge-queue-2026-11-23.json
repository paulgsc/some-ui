      "spoken": {
        "role": "scene",
        "narration": "Catching up is the bigger cost. Both repositories require a branch to be up to date before it merges. So each merge puts every open pull request behind, and each one runs its whole suite again with no change of its own. On one day, that was thirty-eight percent of the minutes here, and sixteen percent on the server."
      },
      "durationMs": 25700
    },
    {
      "id": "P8",
      "picture": {
        "kind": "screen",
