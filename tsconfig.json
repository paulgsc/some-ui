{
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "types": ["@types/node"],
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "pretty": true,
    "sourceMap": true,
    "lib": ["ES2023"],
    "target": "ES2022",
    "paths": {
      "@shared/*": ["./packages/ui/shared/src/*"],
      "@utils/*": ["./packages/utils/src/*"],
      "@leetype/*": ["./packages/ui/leetype/src/*"],
      "@topik/*": ["./packages/ui/topik/src/*"],
      "@honeycomb/*": ["./packages/ui/honeycomb/src/*"],
      "@nfl/*": ["./packages/ui/nfl/src/*"],
      "@types-utils/*": ["./packages/types/src/*"],
      "@wireframes/*": ["./packages/ui/wireframes/src/*"],
      "@attributions/*": ["./packages/ui/attributions/src/*"],
      "@mujik/*": ["./extensions/some-mujik/src/*"],
      "@filter/*": ["./extensions/some-filter/src/*"],
      "@censor/*": ["./extensions/some-censor/src/*"],
      "@suspender/*": ["./extensions/suspender-ledger/src/*"],
      "@some-ui/content/*": ["./packages/some-content/src/*"],
      "@wasm-loader/*": ["./packages/wasm-loader/src/*"],
      "@ws/*": ["./packages/ws/src/*"],
      "@speech/*": ["./packages/speech/src/*"],
      "@activity-catalog/*": ["./packages/activity-catalog/src/*"]
    }
  },
  "include": [
    "eslint/",
    "eslint.config.js",
    "eslint.config-deprecated.mjs",
    "scripts",
    "next.config.mjs",
    "prettier.config.cjs",
    "tailwind.config.ts",
    "vite.config.ts",
    "vitest.config.mts",
    "vitest.config.ts"
  ]
}
