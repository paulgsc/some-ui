{
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "types": ["@types/node"],
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "pretty": true,
    "sourceMap": true,
    "lib": ["ES2023"],
    "target": "ES2022",
    "paths": {
      "@shared/*": ["./packages/ui/shared/src/"],
      "@chat/*": ["./packages/ui/chat/src/"],
      "@utils/*": ["./packages/ui/utils/src/"],
      "@searchbar/*": ["./packages/ui/searchbar/src/"],
      "@slideshow/*": ["./packages/ui/slideshow/src/"],
      "@makjang/*": ["./packages/ui/makjang/src/"],
      "@umag/*": ["./packages/ui/umag/src/"],
      "@nfl/*": ["./packages/ui/nfl/src/"],
      "@wireframes/*": ["./packages/ui/wireframes/src/"],
      "@neon-sign/*": ["./packages/ui/neon-sign/src/"],
      "@portfolio-chart/*": ["./packages/ui/portfolio-chart/src/"],
      "@attributions/*": ["./packages/ui/attributions/src/"],
      "@overlays/*": ["./packages/ui/overlays/src/"]
    }
  },
  "include": [
    "assets/",
    "eslint/",
    "eslint.config.js",
    "eslint.config-deprecated.mjs",
    "next.config.mjs",
    "prettier.config.cjs",
    "tailwind.config.ts",
    "vite.config.ts",
    "vitest.config.mts"
  ]
}
