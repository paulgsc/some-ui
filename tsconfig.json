{
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "types": ["@types/node"],
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "pretty": true,
    "sourceMap": true,
    "lib": ["ES2023"],
    "target": "ES2022",
    "paths": {
      "@shared/*": ["./packages/ui/shared/src/*"],
      "@chat/*": ["./packages/ui/chat/src/*"],
      "@calendar/*": ["./packages/ui/calendar/src/*"],
      "@input/*": ["./packages/ui/input/src/*"],
      "@utils/*": ["./packages/utils/src/*"],
      "@searchbar/*": ["./packages/ui/searchbar/src/*"],
      "@slideshow/*": ["./packages/ui/slideshow/src/*"],
      "@dice-card/*": ["./packages/ui/dice-card/src/*"],
      "@leetype/*": ["./packages/ui/leetype/src/*"],
      "@topik/*": ["./packages/ui/topik/src/*"],
      "@interview/*": ["./packages/ui/interview/src/*"],
      "@makjang/*": ["./packages/ui/makjang/src/"],
      "@honeycomb/*": ["./packages/ui/honeycomb/src/*"],
      "@umag/*": ["./packages/ui/umag/src/*"],
      "@nfl/*": ["./packages/ui/nfl/src/*"],
      "@assessment/*": ["./packages/ui/assessment/src/*"],
      "@types-utils/*": ["./packages/types/src/*"],
      "@stepper/*": ["./packages/ui/stepper/src/*"],
      "@wireframes/*": ["./packages/ui/wireframes/src/*"],
      "@neon-sign/*": ["./packages/ui/neon-sign/src/*"],
      "@portfolio-chart/*": ["./packages/ui/portfolio-chart/src/*"],
      "@attributions/*": ["./packages/ui/attributions/src/*"],
      "@mujik/*": ["./extensions/some-mujik/src/*"],
      "@filter/*": ["./extensions/some-filter/src/*"],
      "@censor/*": ["./extensions/some-censor/src/*"],
      "@streak/*": ["./extensions/some-streak/src/*"],
      "@tab/*": ["./extensions/tab-tracker/src/*"],
      "@prompt/*": ["./extensions/some-prompt/src/*"],
      "@suspender/*": ["./extensions/suspender-ledger/src/*"],
      "@some-ui/content/*": ["./packages/some-content/src/*"],
      "@wasm-loader/*": ["./packages/wasm-loader/src/*"],
      "@ws/*": ["./packages/ws/src/*"]
    }
  },
  "include": [
    "assets/",
    "eslint/",
    "eslint.config.js",
    "eslint.config-deprecated.mjs",
    "scripts",
    "next.config.mjs",
    "prettier.config.cjs",
    "tailwind.config.ts",
    "vite.config.ts",
    "vitest.config.mts",
    "vitest.config.ts"
  ]
}
